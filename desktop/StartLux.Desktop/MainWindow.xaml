<Window x:Class="StartLux.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="StartLux 原神语音助手 · 开发预览" Width="760" Height="850" MinWidth="650" MinHeight="600"
 MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" WindowStartupLocation="CenterScreen" Background="#F5F6FA">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
  <TextBlock Text="用一句话，开始今天的委托" FontSize="26" FontWeight="SemiBold"/>
  <TextBlock Text="蒙德 · 中文游戏界面 · 四项真实委托 + 凯瑟琳每日奖励" Foreground="#52596B" Margin="0,10,0,22"/>
  <Border Background="White" Padding="20" CornerRadius="10"><StackPanel>
   <TextBlock Text="首次设置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
   <TextBlock Text="原神游戏程序完整路径（YuanShen.exe / GenshinImpact.exe）"/>
   <TextBox Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="游戏 UID"/><TextBox Text="{Binding Uid, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="服务器"/><ComboBox ItemsSource="{Binding Servers}" SelectedItem="{Binding Server}" Margin="0,4,0,12" Padding="8"/></StackPanel>
   </Grid>
   <TextBlock Text="StartLux Decision API 模型部署 ID"/>
   <TextBox Text="{Binding ModelId, UpdateSourceTrigger=PropertyChanged}"/>
   <CheckBox Content="确认使用上述模型部署进行每日任务决策" IsChecked="{Binding ModelConfirmed}" Margin="0,0,0,14"/>
   <TextBlock Text="Bamboo API Key（只保存在当前 Windows 用户的加密存储中）"/>
   <PasswordBox x:Name="CredentialBox" Padding="10,7" Margin="0,4,0,0" PasswordChanged="CredentialChanged"/>
  </StackPanel></Border>
  <TextBlock Text="语音或文字指令" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,8"/>
  <TextBlock Text="点击开启语音后，说“开始每日任务”或“停止”。麦克风音频在本机识别。" TextWrapping="Wrap" Foreground="#52596B"/>
  <TextBox Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="任务指令"/>
  <WrapPanel Margin="0,4,0,16">
   <Button Content="启动并执行" Command="{Binding StartCommand}" Background="#2459C4" Foreground="White"/>
   <Button Content="停止接管" Command="{Binding StopCommand}"/>
   <Button Content="{Binding VoiceButtonText}" Command="{Binding ToggleVoiceCommand}"/>
  </WrapPanel>
  <Border Background="White" Padding="16" CornerRadius="10"><StackPanel>
   <TextBlock Text="{Binding Status}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding VoiceStatus}" Foreground="#52596B" Margin="0,8,0,0" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Progress}" Margin="0,12,0,0" TextWrapping="Wrap"/>
   <Button Content="查看本次记录" Command="{Binding OpenRecordsCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
  </StackPanel></Border>
  <TextBlock Text="执行器基于 BetterGI / AutoCommission（GPL-3.0）。请先配置 BetterGI 战斗队伍和策略；不支持的委托会停止并保留现场记录。" Foreground="#52596B" TextWrapping="Wrap" Margin="0,18,0,0"/>
 </StackPanel></ScrollViewer>
</Window>
