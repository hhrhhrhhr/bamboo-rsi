+using BetterGenshinImpact.Service.Agent;
+using Xunit;
+
+namespace BetterGenshinImpact.AgentBridge.Tests;
+
+public sealed class AgentGoalProgressTests
+{
+    [Fact]
+    public void TwoVerifiedFailuresDeferOnlyThatQuest()
+    {
+        var goal = new AgentGoalProgress();
+        goal.Begin(1, "fixture");
+        Assert.Throws<InvalidOperationException>(() => goal.Begin(2, "other"));
+        goal.Verify(false);
+        Assert.True(goal.Available(1));
+        goal.Begin(1, "fixture");
+        goal.Verify(false);
+        Assert.False(goal.Available(1));
+        Assert.True(goal.Available(2));
+        Assert.Throws<InvalidOperationException>(() => goal.Begin(1, "fixture"));
+        goal.Begin(2, "other");
+        goal.Verify(true);
+        Assert.True(goal.Snapshot()["last_verification"]!.Value<bool>("completed"));
+        Assert.Equal(2, goal.Snapshot()["failed_attempts_by_slot"]!.Value<int>("1"));
+    }
+
+    [Fact]
+    public void RescanningDoesNotConsumeAnotherAttemptAndCannotInventSuccess()
+    {
+        var goal = new AgentGoalProgress();
+        goal.Begin(1, "fixture");
+        goal.Verify(false);
+        goal.Verify(true);
+        Assert.False(goal.Snapshot()["last_verification"]!.Value<bool>("completed"));
+        Assert.Equal(1, goal.Snapshot()["failed_attempts_by_slot"]!.Value<int>("1"));
+    }
+
+    [Fact]
+    public void TimedRouteAndPhaseAreExplicit()
+    {
+        var goal = new AgentGoalProgress();
+        goal.Begin(1, "极速前进");
+        Assert.True(goal.TimedRoute);
+        goal.Phase("route");
+        Assert.Equal("route", goal.Snapshot().Value<string>("phase"));
+        Assert.Throws<ArgumentException>(() => goal.Phase("invented_success"));
+        goal.Verify(false);
+        Assert.False(goal.TimedRoute);
+    }
+}
