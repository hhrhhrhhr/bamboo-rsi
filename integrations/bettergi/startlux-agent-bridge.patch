+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Security.Cryptography;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+using BetterGenshinImpact.Core.Script;
+using BetterGenshinImpact.GameTask.Common;
+using BetterGenshinImpact.GameTask.Common.Job;
+using BetterGenshinImpact.Core.Recognition.OCR;
+using Microsoft.ClearScript;
+using Microsoft.ClearScript.V8;
+using Newtonsoft.Json.Linq;
+using OpenCvSharp;
+using BetterGenshinImpact.GameTask.AutoPathing;
+using BetterGenshinImpact.GameTask.AutoPathing.Model;
+using BetterGenshinImpact.GameTask.AutoTrackPath;
+using BetterGenshinImpact.GameTask.Common.BgiVision;
+
+namespace BetterGenshinImpact.Service.Agent;
+
+/// <summary>Per-session journal evidence. A route return never marks a quest done.</summary>
+public sealed class AgentDailyJournal
+{
+    private readonly object _gate = new();
+    private readonly Dictionary<string, byte[]> _resources;
+    private readonly int _timedRouteThreshold;
+    private JObject? _scope;
+    private JArray _rows = new();
+    private readonly Dictionary<int, JObject> _evidence = new();
+    private readonly Dictionary<string, string> _images = new();
+    private readonly Dictionary<int, JObject> _scanEvidence = new();
+    private readonly Dictionary<string, string> _scanImages = new();
+    private JObject? _reward;
+    private bool _needsScan = true;
+    private long _frame;
+    private int? _pendingVerification;
+
+    internal AgentDailyJournal(Dictionary<string, byte[]> resources, int timedRouteThreshold = 0)
+    {
+        _resources = resources;
+        _timedRouteThreshold = AgentTimedRoutePolicy.Validate(timedRouteThreshold);
+    }
+
+    internal (JObject Facts, string[] Images) Snapshot()
+    {
+        lock (_gate)
+        {
+            var valid = _rows.Count == 4 && _evidence.Count == 4;
+            var complete = !_needsScan && valid && _evidence.Values.All(e => e.Value<bool>("completed"));
+            var facts = new JObject
+            {
+                ["daily_needs_scan"] = _needsScan, ["daily_all_complete"] = complete,
+                ["daily_reward_claimed"] = _reward?.Value<bool>("claimed") == true,
+                ["daily_evidence"] = new JObject
+                {
+                    ["expected_quest_ids"] = new JArray(_rows.Select(r => $"{r["id"]}:{r["name"]}")),
+                    ["commissions"] = new JArray(_evidence.Values.Select(e => e.DeepClone())),
+                    ["reward"] = _reward?.DeepClone()
+                }
+            };
+            for (var slot = 1; slot <= 4; slot++)
+            {
+                var row = _rows.FirstOrDefault(r => r.Value<int>("id") == slot);
+                facts[$"daily_slot_{slot}_pending"] = !_needsScan && valid && row != null
+                    && _evidence.TryGetValue(slot, out var evidence) && !evidence.Value<bool>("completed")
+                    && row.Value<bool>("supported") && row.Value<string>("country") == "蒙德"
+                    && row.Value<string>("type") is "fight" or "talk"
+                    && !string.IsNullOrWhiteSpace(row.Value<string>("location"))
+                    && row.Value<string>("location") is not ("未知地点" or "识别失败" or "已完成");
+            }
+            return (facts, _images.Values.ToArray());
+        }
+    }
+
+    // Called synchronously from the trusted JS adapter while the row is visible.
+    public void Record(int slot, string status, Mat journalFrame)
+    {
+        if (slot is < 1 or > 4 || status is not ("completed" or "uncompleted")) return;
+        lock (_gate)
+        {
+            _scanEvidence[slot] = new JObject
+            {
+                ["completed"] = status == "completed",
+                ["evidence"] = VisualEvidence("commission_journal", journalFrame, _scanImages)
+            };
+        }
+    }
+
+    public void SetRows(string json)
+    {
+        var rows = JArray.Parse(json);
+        lock (_gate)
+        {
+            // Completed commissions move to the bottom of the handbook. Keep
+            // stable identities while binding each proof to its visible row.
+            // Commit only after all names and statuses have been validated.
+            var bound = AgentJournalRows.Bind(_rows, rows, _scanEvidence);
+            _rows = bound.Rows;
+            _evidence.Clear();
+            foreach (var pair in bound.Evidence) _evidence.Add(pair.Key, pair.Value);
+            _images.Clear();
+            foreach (var pair in _scanImages) _images.Add(pair.Key, pair.Value);
+            _needsScan = false;
+            if (_pendingVerification is int slot)
+            {
+                if (!_evidence.TryGetValue(slot, out var completed) || !completed.Value<bool>("completed"))
+                    throw new InvalidDataException("Selected commission did not become complete in the journal; no automatic retry.");
+                _pendingVerification = null;
+            }
+        }
+    }
+
+    public void RecordReward()
+    {
+        using var capture = TaskControl.CaptureToRectArea();
+        var text = OcrFactory.Paddle.Ocr(capture.SrcMat);
+        // Do not accept a random occurrence of 'claimed' outside the handbook.
+        if (!text.Contains("每日委托奖励", StringComparison.Ordinal)
+            || !text.Contains("今日奖励已领取", StringComparison.Ordinal))
+            throw new InvalidDataException("Daily reward claim could not be verified in the handbook.");
+        lock (_gate)
+            _reward = new JObject { ["claimed"] = true, ["primogems"] = null,
+                ["evidence"] = VisualEvidence("daily_reward_ui", capture.SrcMat) };
+    }
+
+    private JObject VisualEvidence(string source, Mat image, Dictionary<string, string>? images = null)
+    {
+        Cv2.ImEncode(".png", image, out var bytes);
+        var hash = Convert.ToHexString(SHA256.HashData(bytes)).ToLowerInvariant();
+        (images ?? _images)[hash] = "data:image/png;base64," + Convert.ToBase64String(bytes);
+        return new JObject { ["scope"] = _scope!.DeepClone(), ["frame_id"] = ++_frame,
+            ["screenshot_sha256"] = hash, ["source"] = source };
+    }
+
+    internal async Task ExecuteAsync(string skill, JObject arguments, JObject scope, CancellationToken ct)
+    {
+        JObject? quest = null;
+        bool firstScan = false;
+        lock (_gate)
+        {
+            if (_scope != null && !JToken.DeepEquals(_scope, scope))
+                throw new InvalidOperationException("Daily account or game day changed.");
+            _scope = (JObject)scope.DeepClone();
+            if (skill == "daily.scan")
+            {
+                firstScan = _rows.Count == 0;
+                _needsScan = true;
+                _scanEvidence.Clear(); _scanImages.Clear();
+                if (_reward != null) _reward = null;
+            }
+            else if (skill == "daily.execute")
+            {
+                var slot = arguments.Value<int>("slot");
+                if (Snapshot().Facts.Value<bool>($"daily_slot_{slot}_pending") != true)
+                    throw new InvalidOperationException("Commission is not available for execution.");
+                quest = (JObject)_rows.Single(r => r.Value<int>("id") == slot).DeepClone();
+                _needsScan = true;
+                _pendingVerification = slot;
+            }
+            else if (skill == "daily.claim")
+            {
+                if (Snapshot().Facts.Value<bool>("daily_all_complete") != true || _needsScan)
+                    throw new InvalidOperationException("Four completed commissions are required before claiming.");
+            }
+            else throw new InvalidDataException("Unsupported daily operation.");
+        }
+
+        if (firstScan)
+        {
+            // The model has selected the account/foreground-guarded scan skill.
+            // Recover this known free respawn screen before opening the journal.
+            using (var capture = TaskControl.CaptureToRectArea())
+            {
+                if (AgentRecoveryUi.IsColdDefeat(OcrFactory.Paddle.Ocr(capture.SrcMat)))
+                {
+                    ct.ThrowIfCancellationRequested();
+                    if (!Bv.ClickIfInReviveModal(capture))
+                        throw new InvalidOperationException("Cold defeat respawn button was not verified.");
+                    await Task.Delay(1500, ct);
+                }
+            }
+            await new ReturnMainUiTask().Start(ct);
+            bool ready = false;
+            for (var attempt = 0; attempt < 30; attempt++)
+            {
+                ct.ThrowIfCancellationRequested();
+                using var capture = TaskControl.CaptureToRectArea();
+                if (Bv.IsInMainUi(capture)
+                    && !AgentRecoveryUi.IsColdDefeat(OcrFactory.Paddle.Ocr(capture.SrcMat)))
+                { ready = true; break; }
+                await Task.Delay(500, ct);
+            }
+            if (!ready) throw new InvalidOperationException("Game did not leave the recovery/loading view.");
+            // Waiting for optimization can otherwise leave the party exposed
+            // to cold damage. Start the journal from the configured free statue.
+            await new TpTask(ct).TpToStatueOfTheSeven();
+        }
+
+        if (skill == "daily.claim")
+        {
+            // Reuse navigation only; upstream DoOnce also claims expeditions.
+            await new GoToAdventurersGuildTask().GoToAdventurersGuild("蒙德", ct);
+            var talk = new ChooseTalkOptionTask();
+            var selection = await talk.SingleSelectText("每日委托", ct, 5, true);
+            if (selection is not (TalkOptionRes.FoundAndClick or TalkOptionRes.FoundButNotOrange))
+                throw new InvalidOperationException("Daily reward dialogue option was not selected.");
+            await Task.Delay(800, ct);
+            if (selection == TalkOptionRes.FoundAndClick)
+            {
+                using var confirmation = TaskControl.CaptureToRectArea();
+                BetterGenshinImpact.GameTask.Common.BgiVision.Bv.ClickBlackConfirmButton(confirmation);
+                await Task.Delay(300, ct);
+            }
+            await talk.SelectLastOptionUntilEnd(ct, null, 3);
+            await new ReturnMainUiTask().Start(ct);
+        }
+
+        // Every operation starts from pinned bytes in a new working directory.
+        // Upstream's writable Data files are never reused as trusted game state.
+        var directory = Path.Combine(Path.GetTempPath(), "StartLux", Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(directory);
+        try
+        {
+            foreach (var (name, bytes) in _resources.Where(p => p.Key.StartsWith("autocommission/", StringComparison.Ordinal)))
+            {
+                var target = Path.Combine(directory, name[15..]);
+                Directory.CreateDirectory(Path.GetDirectoryName(target)!);
+                await File.WriteAllBytesAsync(target, bytes, ct);
+            }
+            using var engine = new V8ScriptEngine(V8ScriptEngineFlags.UseCaseInsensitiveMemberBinding | V8ScriptEngineFlags.EnableTaskPromiseConversion);
+            EngineExtend.InitHost(engine, directory);
+            var scriptInput = new AgentScriptInput(
+                Core.Script.Dependence.GlobalMethod.KeyPress,
+                Core.Script.Dependence.GlobalMethod.KeyDown,
+                Core.Script.Dependence.GlobalMethod.KeyUp,
+                milliseconds =>
+                {
+                    if (ct.WaitHandle.WaitOne(milliseconds)) ct.ThrowIfCancellationRequested();
+                },
+                () =>
+                {
+                    ct.ThrowIfCancellationRequested();
+                    using var capture = TaskControl.CaptureToRectArea();
+                    return Bv.IsInTalkUi(capture);
+                },
+                quest?.Value<string>("type") == "talk");
+            engine.AddHostObject("keyPress", (Action<string>)scriptInput.Press);
+            // The standard JS wrapper catches path failures. Use a strict executor
+            // and retain its failure independently of upstream catch/continue code.
+            var routes = new AgentPinnedRoutes(_resources, ct, _timedRouteThreshold);
+            engine.AddHostObject("pathingScript", routes);
+            engine.AddHostObject("agentJournal", this);
+            engine.AddHostObject("settings", new PropertyBag
+            {
+                ["operation"] = skill == "daily.scan" ? "scan" : skill == "daily.claim" ? "reward-check" : "execute",
+                ["questJson"] = quest?.ToString(Newtonsoft.Json.Formatting.None) ?? "{}",
+                ["team"] = "", ["elementTeam"] = "", ["prepare"] = true,
+                ["skipRecognition"] = false, ["skipCommissions"] = ""
+            });
+            using var interrupt = ct.Register(() => { CancellationContext.Instance.Cts.Cancel(); engine.Interrupt(); });
+            ct.ThrowIfCancellationRequested();
+            if (engine.Evaluate(Encoding.UTF8.GetString(_resources["agent-main.js"])) is Task task) await task;
+            ct.ThrowIfCancellationRequested();
+            scriptInput.VerifyDialogue();
+            if (routes.Failed) throw new InvalidOperationException("A pinned commission route failed.");
+        }
+        finally
+        {
+            try { Directory.Delete(directory, true); } catch (IOException) { }
+        }
+    }
+}
+
+public sealed class AgentPinnedRoutes
+{
+    private readonly Dictionary<string, byte[]> _resources;
+    private readonly CancellationToken _token;
+    internal bool Failed { get; private set; }
+    private readonly int _timedRouteThreshold;
+    internal AgentPinnedRoutes(Dictionary<string, byte[]> resources, CancellationToken token, int timedRouteThreshold = 0)
+    { _resources = resources; _token = token; _timedRouteThreshold = AgentTimedRoutePolicy.Validate(timedRouteThreshold); }
+
+    internal static PathingTask ParseResource(byte[] bytes)
+    {
+        // Pinned resources retain their original bytes and hash. As with
+        // File.ReadAllText, consume the optional UTF-8 BOM before JSON parsing.
+        var offset = bytes.AsSpan().StartsWith(new byte[] { 0xEF, 0xBB, 0xBF }) ? 3 : 0;
+        return PathingTask.BuildFromJson(new UTF8Encoding(false, true).GetString(bytes, offset, bytes.Length - offset));
+    }
+
+    public async Task RunFile(string path)
+    {
+        try
+        {
+            _token.ThrowIfCancellationRequested();
+            var name = "autocommission/" + path.Replace('\\', '/');
+            if (!_resources.TryGetValue(name, out var bytes))
+                throw new InvalidDataException("Route is outside the pinned source pack.");
+            var route = ParseResource(bytes);
+            var executor = new PathExecutor(_token);
+            executor.PartyConfig.VerifiedCommissionCombat = true;
+            // Optional looting previously consumed 45 seconds in this timed
+            // commission. The override belongs only to this executor instance.
+            executor.PartyConfig.SuppressOptionalBattleLoot =
+                name.StartsWith("autocommission/assets/极速前进/", StringComparison.Ordinal);
+            if (executor.PartyConfig.SuppressOptionalBattleLoot)
+                executor.PartyConfig.TimedRouteSkipCombatBelowSeconds = _timedRouteThreshold;
+            await executor.Pathing(route);
+            _token.ThrowIfCancellationRequested();
+            if (!executor.SuccessEnd) throw new InvalidOperationException("Route did not complete.");
+        }
+        catch { Failed = true; throw; }
+    }
+}
