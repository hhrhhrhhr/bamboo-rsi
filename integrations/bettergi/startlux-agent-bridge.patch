+using System;
+using BetterGenshinImpact.Service.Agent;
+using Xunit;
+
+namespace BetterGenshinImpact.AgentBridge.Tests;
+
+public sealed class AgentTimedRoutePolicyTests
+{
+    private const string Active = "击败魔物获取更多时间\n中断挑战\n";
+
+    [Theory]
+    [InlineData("00:29\n剩余时间：29秒", 29)]
+    [InlineData("01:02", 62)]
+    [InlineData("剩余时间:45秒", 45)]
+    public void ReadsObservedChallengeTimer(string text, int seconds)
+        => Assert.Equal(seconds, AgentTimedRoutePolicy.RemainingSeconds(Active + text));
+
+    [Theory]
+    [InlineData("00:58\n剩余时间:58秒\n消灭魔物会获得额外时间\nP 中断挑战", 58)]
+    [InlineData("00:39\n剩余时间：39秒\n消灭魔物会获得额外时间\n中断挑战", 39)]
+    public void ReadsActualSnowMountainVideoWording(string text, int seconds)
+        => Assert.Equal(seconds, AgentTimedRoutePolicy.RemainingSeconds(text));
+
+    [Fact]
+    public void MonsterTimeBonusTextWithoutActiveChallengeCannotEnableSkipping()
+        => Assert.Null(AgentTimedRoutePolicy.RemainingSeconds("00:58\n消灭魔物会获得额外时间"));
+
+    [Theory]
+    [InlineData("00:29\n击败魔物获取更多时间")]
+    [InlineData("00:29\n中断挑战")]
+    [InlineData("00:29\n剩余时间：29秒")]
+    [InlineData("击败魔物获取更多时间\n中断挑战\n剩余时间：29秒\n00:49")]
+    [InlineData("击败魔物获取更多时间\n中断挑战\n00:00")]
+    [InlineData("击败魔物获取更多时间\n中断挑战\n03:99")]
+    public void UnrelatedAmbiguousOrExpiredTimersCannotEnableSkipping(string text)
+        => Assert.Null(AgentTimedRoutePolicy.RemainingSeconds(text));
+
+    [Fact]
+    public void PreservesParentAndUnknownTimerBehavior()
+    {
+        Assert.False(AgentTimedRoutePolicy.SkipFight(0, 10));
+        Assert.False(AgentTimedRoutePolicy.SkipFight(0, null));
+        foreach (var retired in new[] { 30, 45, 60 })
+            Assert.Throws<ArgumentOutOfRangeException>(() => AgentTimedRoutePolicy.Validate(retired));
+        Assert.Throws<ArgumentOutOfRangeException>(() => AgentTimedRoutePolicy.Validate(120));
+    }
+}
