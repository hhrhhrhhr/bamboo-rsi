diff --git a/BetterGenshinImpact/Service/Agent/AgentCommissionReceipt.cs b/BetterGenshinImpact/Service/Agent/AgentCommissionReceipt.cs
new file mode 100644
index 0000000..15b7e9b
--- /dev/null
+++ b/BetterGenshinImpact/Service/Agent/AgentCommissionReceipt.cs
@@ -0,0 +1,67 @@
+using System;
+using System.Text.RegularExpressions;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.Service.Agent;
+
+/// <summary>Fresh commission reward toast, never inventory or a combat timeout.</summary>
+internal sealed class AgentCommissionReceipt
+{
+    private bool _armed;
+    private long? _bannerAt;
+    private long? _firstReceiptAt;
+    private long? _lastReceiptAt;
+    internal bool Received { get; private set; }
+    internal int? Amount { get; private set; }
+
+    internal bool Observe(long milliseconds, string banner, string loot, bool primogemPopup = false)
+    {
+        if (Received) return true;
+        banner = Regex.Replace(banner, @"\s+", "");
+        loot = Regex.Replace(loot, @"\s+", "");
+        var completed = banner.Contains("委托完成", StringComparison.Ordinal);
+        // The configured Paddle V6 omits the multiplication glyph in real toasts.
+        var primogems = Regex.IsMatch(loot, @"原石[×xX*]?10(?![0-9])");
+        var commissionReward = loot.Contains("委托奖励", StringComparison.Ordinal);
+        // Do not inherit a toast left over from the previous selected skill.
+        if (!_armed)
+        {
+            _armed = !completed && !primogems && !commissionReward && !primogemPopup;
+            return false;
+        }
+        if (completed) _bannerAt = milliseconds;
+        var recentBanner = _bannerAt is long at && milliseconds >= at && milliseconds - at <= 8000;
+        if (!(primogems && (commissionReward || recentBanner)) && !(primogemPopup && recentBanner))
+        {
+            _firstReceiptAt = _lastReceiptAt = null;
+            return false;
+        }
+        if (_lastReceiptAt is not long last || milliseconds <= last || milliseconds - last > 1500)
+            _firstReceiptAt = milliseconds;
+        _lastReceiptAt = milliseconds;
+        // Require two temporally separate observations; a single OCR hit is insufficient.
+        Received = milliseconds - _firstReceiptAt!.Value >= 200;
+        if (Received) Amount = primogems ? 10 : null; // An icon alone proves no numeric delta.
+        return Received;
+    }
+
+    internal static bool HasPrimogemPopup(Mat normalizedFrame, Mat template)
+    {
+        // The central obtained-item card only; inventory and left-hand item lists
+        // are outside this ROI. Caller additionally requires a fresh completion banner.
+        using var center = normalizedFrame.SubMat(new Rect(820, 460, 280, 160));
+        using var bgr = new Mat();
+        if (center.Channels() == 4) Cv2.CvtColor(center, bgr, ColorConversionCodes.BGRA2BGR);
+        else center.CopyTo(bgr);
+        foreach (var scale in new[] { 0.70, 0.75, 0.80 })
+        {
+            using var icon = new Mat();
+            Cv2.Resize(template, icon, new Size(), scale, scale);
+            using var scores = new Mat();
+            Cv2.MatchTemplate(bgr, icon, scores, TemplateMatchModes.CCoeffNormed);
+            Cv2.MinMaxLoc(scores, out _, out double best);
+            if (best >= 0.85) return true;
+        }
+        return false;
+    }
+}
diff --git a/BetterGenshinImpact/Service/Agent/AgentDailyJournal.cs b/BetterGenshinImpact/Service/Agent/AgentDailyJournal.cs
new file mode 100644
index 0000000..a3edf7f
--- /dev/null
+++ b/BetterGenshinImpact/Service/Agent/AgentDailyJournal.cs
@@ -0,0 +1,490 @@
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.IO;
+using System.Linq;
+using System.Security.Cryptography;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+using BetterGenshinImpact.Core.Script;
+using BetterGenshinImpact.GameTask.Common;
+using BetterGenshinImpact.GameTask;
+using BetterGenshinImpact.GameTask.Common.Job;
+using BetterGenshinImpact.Core.Recognition.OCR;
+using Microsoft.ClearScript;
+using Microsoft.ClearScript.V8;
+using Newtonsoft.Json.Linq;
+using OpenCvSharp;
+using BetterGenshinImpact.GameTask.AutoPathing;
+using BetterGenshinImpact.GameTask.AutoPathing.Model;
+using BetterGenshinImpact.GameTask.AutoTrackPath;
+using BetterGenshinImpact.GameTask.Common.BgiVision;
+using BetterGenshinImpact.Core.Input;
+using BetterGenshinImpact.Core.Simulator.Extensions;
+
+namespace BetterGenshinImpact.Service.Agent;
+
+/// <summary>Per-session journal evidence. A route return never marks a quest done.</summary>
+public sealed class AgentDailyJournal
+{
+    private readonly object _gate = new();
+    private readonly Dictionary<string, byte[]> _resources;
+    private readonly int _timedRouteThreshold;
+    private JObject? _scope;
+    private JArray _rows = new();
+    private readonly Dictionary<int, JObject> _evidence = new();
+    private readonly Dictionary<string, string> _images = new();
+    private readonly Dictionary<int, JObject> _scanEvidence = new();
+    private readonly Dictionary<string, string> _scanImages = new();
+    private JObject? _reward;
+    private bool _needsScan = true;
+    private long _frame;
+    private int? _pendingVerification;
+    private readonly AgentGoalProgress _goal;
+    private JObject? _commissionReceipt;
+    private bool _receiptStopped;
+    private readonly Dictionary<string, string> _receiptImages = new();
+    public bool CommissionRewardReceived { get { lock (_gate) return _receiptStopped; } }
+    public void ReportPhase(string phase) { lock (_gate) _goal.Phase(phase); }
+    internal bool ReviewInterruptible { get { lock (_gate) return !_goal.TimedRoute; } }
+
+    internal AgentDailyJournal(Dictionary<string, byte[]> resources, AgentGoalMemory memory, int timedRouteThreshold = 0)
+    {
+        _resources = resources;
+        _goal = new AgentGoalProgress(memory);
+        _timedRouteThreshold = AgentTimedRoutePolicy.Validate(timedRouteThreshold);
+    }
+
+    internal (JObject Facts, string[] Images) Snapshot()
+    {
+        lock (_gate)
+        {
+            var valid = _rows.Count == 4 && _evidence.Count == 4;
+            var complete = !_needsScan && valid && _evidence.Values.All(e => e.Value<bool>("completed"));
+            var facts = new JObject
+            {
+                ["daily_needs_scan"] = _needsScan, ["daily_all_complete"] = complete,
+                ["daily_reward_claimed"] = _reward?.Value<bool>("claimed") == true,
+                ["commission_reward_receipt"] = _commissionReceipt?.DeepClone(),
+                ["daily_goal"] = _goal.Snapshot(),
+                ["daily_evidence"] = new JObject
+                {
+                    ["expected_quest_ids"] = new JArray(_rows.Select(r => $"{r["id"]}:{r["name"]}")),
+                    ["commissions"] = new JArray(_evidence.Values.Select(e => e.DeepClone())),
+                    ["reward"] = _reward?.DeepClone()
+                }
+            };
+            for (var slot = 1; slot <= 4; slot++)
+            {
+                var row = _rows.FirstOrDefault(r => r.Value<int>("id") == slot);
+                var eligible = !_needsScan && valid && row != null
+                    && _evidence.TryGetValue(slot, out var evidence) && !evidence.Value<bool>("completed")
+                    && row.Value<bool>("supported") && row.Value<string>("country") == "蒙德"
+                    && row.Value<string>("type") is "fight" or "talk"
+                    && !string.IsNullOrWhiteSpace(row.Value<string>("location"))
+                    && row.Value<string>("location") is not ("未知地点" or "识别失败" or "已完成");
+                facts[$"daily_slot_{slot}_pending"] = eligible && _goal.Available(slot);
+                facts[$"daily_slot_{slot}_retry"] = eligible && _goal.CanRetry(slot);
+                facts[$"daily_slot_{slot}_local_recovery"] = eligible && _goal.LocalRecovery(slot)
+                    && row!.Value<string>("type") == "fight";
+            }
+            return (facts, _images.Values.Concat(_receiptImages.Values).ToArray());
+        }
+    }
+
+    // Called synchronously from the trusted JS adapter while the row is visible.
+    public void Record(int slot, string status, Mat journalFrame)
+    {
+        if (slot is < 1 or > 4 || status is not ("completed" or "uncompleted")) return;
+        lock (_gate)
+        {
+            _scanEvidence[slot] = new JObject
+            {
+                ["completed"] = status == "completed",
+                ["evidence"] = VisualEvidence("commission_journal", journalFrame, _scanImages)
+            };
+        }
+    }
+
+    public void SetRows(string json)
+    {
+        var rows = JArray.Parse(json);
+        lock (_gate)
+        {
+            // Completed commissions move to the bottom of the handbook. Keep
+            // stable identities while binding each proof to its visible row.
+            // Commit only after all names and statuses have been validated.
+            var bound = AgentJournalRows.Bind(_rows, rows, _scanEvidence);
+            _goal.BindRows(bound.Rows);
+            _rows = bound.Rows;
+            _evidence.Clear();
+            foreach (var pair in bound.Evidence) _evidence.Add(pair.Key, pair.Value);
+            _images.Clear();
+            foreach (var pair in _scanImages) _images.Add(pair.Key, pair.Value);
+            _needsScan = false;
+            if (_pendingVerification is int slot)
+            {
+                // An incomplete commission is valid evidence for replanning,
+                // not a failed scan or a reason to abandon the other quests.
+                _goal.Verify(_evidence.TryGetValue(slot, out var completed) && completed.Value<bool>("completed"));
+                _pendingVerification = null;
+            }
+        }
+    }
+
+    public void RecordReward()
+    {
+        using var capture = TaskControl.CaptureToRectArea();
+        var text = OcrFactory.Paddle.Ocr(capture.SrcMat);
+        // Do not accept a random occurrence of 'claimed' outside the handbook.
+        if (!text.Contains("每日委托奖励", StringComparison.Ordinal)
+            || !text.Contains("今日奖励已领取", StringComparison.Ordinal))
+            throw new InvalidDataException("Daily reward claim could not be verified in the handbook.");
+        lock (_gate)
+            _reward = new JObject { ["claimed"] = true, ["primogems"] = null,
+                ["evidence"] = VisualEvidence("daily_reward_ui", capture.SrcMat) };
+    }
+
+    private JObject VisualEvidence(string source, Mat image, Dictionary<string, string>? images = null)
+    {
+        Cv2.ImEncode(".png", image, out var bytes);
+        var hash = Convert.ToHexString(SHA256.HashData(bytes)).ToLowerInvariant();
+        (images ?? _images)[hash] = "data:image/png;base64," + Convert.ToBase64String(bytes);
+        return new JObject { ["scope"] = _scope!.DeepClone(), ["frame_id"] = ++_frame,
+            ["screenshot_sha256"] = hash, ["source"] = source };
+    }
+
+    internal async Task ExecuteAsync(string skill, JObject arguments, JObject scope, CancellationToken ct)
+    {
+        JObject? quest = null;
+        string? recovery = null;
+        bool firstScan = false;
+        lock (_gate)
+        {
+            _receiptStopped = false;
+            if (_scope != null && !JToken.DeepEquals(_scope, scope))
+                throw new InvalidOperationException("Daily account or game day changed.");
+            _scope = (JObject)scope.DeepClone();
+            _goal.BindScope(scope);
+            if (skill == "daily.scan")
+            {
+                firstScan = _rows.Count == 0;
+                _needsScan = true;
+                _scanEvidence.Clear(); _scanImages.Clear();
+                if (_reward != null) _reward = null;
+            }
+            else if (skill is "daily.execute" or "daily.recover")
+            {
+                var slot = arguments.Value<int>("slot");
+                if (skill == "daily.recover")
+                {
+                    recovery = arguments.Value<string>("mode");
+                    if (recovery is not ("ranged" or "reposition_left" or "reposition_right" or "heal_retry"))
+                        throw new InvalidDataException("Unknown bounded recovery mode.");
+                }
+                var gate = recovery == null ? "pending" : recovery == "heal_retry" ? "retry" : "local_recovery";
+                if (Snapshot().Facts.Value<bool>($"daily_slot_{slot}_{gate}") != true)
+                    throw new InvalidOperationException("Commission is not available for execution.");
+                quest = (JObject)_rows.Single(r => r.Value<int>("id") == slot).DeepClone();
+                _goal.Begin(slot, quest.Value<string>("name")!, recovery ?? "default");
+                _commissionReceipt = null;
+                _receiptImages.Clear();
+                _needsScan = true;
+                _pendingVerification = slot;
+            }
+            else if (skill == "daily.claim")
+            {
+                if (Snapshot().Facts.Value<bool>("daily_all_complete") != true || _needsScan)
+                    throw new InvalidOperationException("Four completed commissions are required before claiming.");
+            }
+            else throw new InvalidDataException("Unsupported daily operation.");
+        }
+
+        if (recovery != null)
+        {
+            RequireRecoveryGround(ct);
+            ReportPhase("recover");
+            if (recovery == "heal_retry")
+            {
+                await new TpTask(ct).TpToStatueOfTheSeven();
+                await Task.Delay(5000, ct);
+                RequireRecoveryGround(ct);
+                using var capture = TaskControl.CaptureToRectArea();
+                if (Bv.CurrentAvatarIsLowHp(capture))
+                    throw new InvalidOperationException("Statue recovery did not clear the low health indicator.");
+                ReportPhase("prepare");
+                // Continue through the pinned original route. This changed
+                // preparation consumes the second attempt even if it fails.
+            }
+            else
+            {
+                using var monitoring = CancellationTokenSource.CreateLinkedTokenSource(ct);
+                var monitor = Task.Run(() => WatchCommissionReceiptAsync(quest!, monitoring.Token));
+                try { await RecoverCombatAsync(recovery, ct); }
+                finally { monitoring.Cancel(); await monitor.ConfigureAwait(false); }
+                ReportPhase("verify");
+                return; // Never claim kills or completion from this bounded burst.
+            }
+        }
+
+        if (firstScan)
+        {
+            // The model has selected the account/foreground-guarded scan skill.
+            // Recover this known free respawn screen before opening the journal.
+            using (var capture = TaskControl.CaptureToRectArea())
+            {
+                if (AgentRecoveryUi.IsColdDefeat(OcrFactory.Paddle.Ocr(capture.SrcMat)))
+                {
+                    ct.ThrowIfCancellationRequested();
+                    if (!Bv.ClickIfInReviveModal(capture))
+                        throw new InvalidOperationException("Cold defeat respawn button was not verified.");
+                    await Task.Delay(1500, ct);
+                }
+            }
+            await new ReturnMainUiTask().Start(ct);
+            bool ready = false;
+            for (var attempt = 0; attempt < 30; attempt++)
+            {
+                ct.ThrowIfCancellationRequested();
+                using var capture = TaskControl.CaptureToRectArea();
+                if (Bv.IsInMainUi(capture)
+                    && !AgentRecoveryUi.IsColdDefeat(OcrFactory.Paddle.Ocr(capture.SrcMat)))
+                { ready = true; break; }
+                await Task.Delay(500, ct);
+            }
+            if (!ready) throw new InvalidOperationException("Game did not leave the recovery/loading view.");
+            // Waiting for optimization can otherwise leave the party exposed
+            // to cold damage. Start the journal from the configured free statue.
+            await new TpTask(ct).TpToStatueOfTheSeven();
+        }
+
+        if (skill == "daily.claim")
+        {
+            // Reuse navigation only; upstream DoOnce also claims expeditions.
+            await new GoToAdventurersGuildTask().GoToAdventurersGuild("蒙德", ct);
+            var talk = new ChooseTalkOptionTask();
+            var selection = await talk.SingleSelectText("每日委托", ct, 5, true);
+            if (selection is not (TalkOptionRes.FoundAndClick or TalkOptionRes.FoundButNotOrange))
+                throw new InvalidOperationException("Daily reward dialogue option was not selected.");
+            await Task.Delay(800, ct);
+            if (selection == TalkOptionRes.FoundAndClick)
+            {
+                using var confirmation = TaskControl.CaptureToRectArea();
+                BetterGenshinImpact.GameTask.Common.BgiVision.Bv.ClickBlackConfirmButton(confirmation);
+                await Task.Delay(300, ct);
+            }
+            await talk.SelectLastOptionUntilEnd(ct, null, 3);
+            await new ReturnMainUiTask().Start(ct);
+        }
+
+        // Every operation starts from pinned bytes in a new working directory.
+        // Upstream's writable Data files are never reused as trusted game state.
+        var directory = Path.Combine(Path.GetTempPath(), "StartLux", Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(directory);
+        try
+        {
+            foreach (var (name, bytes) in _resources.Where(p => p.Key.StartsWith("autocommission/", StringComparison.Ordinal)))
+            {
+                var target = Path.Combine(directory, name[15..]);
+                Directory.CreateDirectory(Path.GetDirectoryName(target)!);
+                await File.WriteAllBytesAsync(target, bytes, ct);
+            }
+            using var engine = new V8ScriptEngine(V8ScriptEngineFlags.UseCaseInsensitiveMemberBinding | V8ScriptEngineFlags.EnableTaskPromiseConversion);
+            EngineExtend.InitHost(engine, directory);
+            var scriptInput = new AgentScriptInput(
+                Core.Script.Dependence.GlobalMethod.KeyPress,
+                Core.Script.Dependence.GlobalMethod.KeyDown,
+                Core.Script.Dependence.GlobalMethod.KeyUp,
+                milliseconds =>
+                {
+                    if (ct.WaitHandle.WaitOne(milliseconds)) ct.ThrowIfCancellationRequested();
+                },
+                () =>
+                {
+                    ct.ThrowIfCancellationRequested();
+                    using var capture = TaskControl.CaptureToRectArea();
+                    return Bv.IsInTalkUi(capture);
+                },
+                quest?.Value<string>("type") == "talk");
+            engine.AddHostObject("keyPress", (Action<string>)scriptInput.Press);
+            // The standard JS wrapper catches path failures. Use a strict executor
+            // and retain its failure independently of upstream catch/continue code.
+            var routes = new AgentPinnedRoutes(_resources, ct, _timedRouteThreshold, ReportPhase);
+            engine.AddHostObject("pathingScript", routes);
+            engine.AddHostObject("agentJournal", this);
+            engine.AddHostObject("settings", new PropertyBag
+            {
+                ["operation"] = skill == "daily.scan" ? "scan" : skill == "daily.claim" ? "reward-check" : "execute",
+                ["questJson"] = quest?.ToString(Newtonsoft.Json.Formatting.None) ?? "{}",
+                ["team"] = "", ["elementTeam"] = "", ["prepare"] = true,
+                ["skipRecognition"] = false, ["skipCommissions"] = ""
+            });
+            using var interrupt = ct.Register(() =>
+            {
+                CancellationContext.Instance.Cancel();
+                // Every executing quest must join its native tasks before a new
+                // Decision skill; interrupting JS promises early loses that join.
+                if (quest == null) engine.Interrupt();
+            });
+            using var monitoring = CancellationTokenSource.CreateLinkedTokenSource(ct);
+            var receiptMonitor = quest == null ? Task.CompletedTask
+                : Task.Run(() => WatchCommissionReceiptAsync(quest, monitoring.Token));
+            try
+            {
+                ct.ThrowIfCancellationRequested();
+                if (engine.Evaluate(Encoding.UTF8.GetString(_resources["agent-main.js"])) is Task task) await task;
+                ct.ThrowIfCancellationRequested();
+                scriptInput.VerifyDialogue();
+                if (routes.Failed) throw new InvalidOperationException("A pinned commission route failed.");
+            }
+            finally
+            {
+                monitoring.Cancel();
+                await receiptMonitor.ConfigureAwait(false);
+            }
+        }
+        finally
+        {
+            try { Directory.Delete(directory, true); } catch (IOException) { }
+        }
+    }
+
+    private static void RequireRecoveryGround(CancellationToken ct)
+    {
+        ct.ThrowIfCancellationRequested();
+        using var capture = TaskControl.CaptureToRectArea();
+        if (!Bv.IsInMainUi(capture) || Bv.GetMotionStatus(capture) != MotionStatus.Normal)
+            throw new InvalidOperationException("Recovery requires a current grounded world view.");
+    }
+
+    private static async Task RecoverCombatAsync(string mode, CancellationToken ct)
+    {
+        var scenes = await RunnerContext.Instance.GetCombatScenes(ct)
+            ?? throw new InvalidOperationException("Party recognition is unavailable.");
+        scenes.BeforeTask(ct);
+        var ranged = scenes.GetAvatars().SingleOrDefault(a => a.Name == "夜兰")
+            ?? throw new InvalidOperationException("The bounded ranged recovery requires Yelan in the current party.");
+        RequireRecoveryGround(ct);
+        if (!ranged.TrySwitch(2)) throw new InvalidOperationException("Could not verify the ranged character switch.");
+        RequireRecoveryGround(ct);
+        if (mode is "reposition_left" or "reposition_right")
+        {
+            var move = mode == "reposition_left" ? GIActions.MoveLeft : GIActions.MoveRight;
+            try
+            {
+                InputHub.Foreground.SimulateAction(move, KeyType.KeyDown);
+                await Task.Delay(350, ct);
+            }
+            finally { InputHub.Foreground.SimulateAction(move, KeyType.KeyUp); }
+        }
+        var timer = Stopwatch.StartNew();
+        while (timer.Elapsed < TimeSpan.FromSeconds(15))
+        {
+            RequireRecoveryGround(ct);
+            using (var capture = TaskControl.CaptureToRectArea())
+                if (Bv.CurrentAvatarIsLowHp(capture))
+                    throw new InvalidOperationException("Low health prevents continued ranged recovery.");
+            ranged.Attack(); // One normal shot; never creates another Zhongli pillar.
+            ct.ThrowIfCancellationRequested();
+        }
+    }
+
+    private async Task WatchCommissionReceiptAsync(JObject quest, CancellationToken ct)
+    {
+        var detector = new AgentCommissionReceipt();
+        var clock = Stopwatch.StartNew();
+        try
+        {
+            using var primogemTemplate = BetterGenshinImpact.GameTask.GameTaskManager.LoadAssetImage(
+                @"Common\Element", "primogem.png", 1920, 1080);
+            while (!ct.IsCancellationRequested)
+            {
+                using var capture = TaskControl.CaptureToRectArea();
+                using var normalized = new Mat();
+                Cv2.Resize(capture.SrcMat, normalized, new Size(1920, 1080));
+                // Limit OCR to the completion banner and obtained-items toast.
+                // Inventory/shop text elsewhere cannot trigger this stop.
+                using var banner = normalized.SubMat(new Rect(450, 130, 1020, 170));
+                using var loot = normalized.SubMat(new Rect(65, 460, 440, 370));
+                var bannerText = OcrFactory.Paddle.Ocr(banner);
+                var lootText = OcrFactory.Paddle.Ocr(loot);
+                ct.ThrowIfCancellationRequested();
+                if (detector.Observe(clock.ElapsedMilliseconds, bannerText, lootText,
+                    AgentCommissionReceipt.HasPrimogemPopup(normalized, primogemTemplate)))
+                {
+                    lock (_gate)
+                    {
+                        _commissionReceipt = new JObject
+                        {
+                            ["quest_id"] = $"{quest["id"]}:{quest["name"]}",
+                            ["primogems"] = detector.Amount, ["observed_at"] = DateTimeOffset.UtcNow,
+                            ["requires_journal_verification"] = true,
+                            ["evidence"] = VisualEvidence("commission_primogem_receipt", capture.SrcMat, _receiptImages)
+                        };
+                        _receiptStopped = true;
+                    }
+                    // This is a task-completion stop, not an assertion that all
+                    // surrounding enemies died. Normal cancellation joins combat.
+                    CancellationContext.Instance.Cancel();
+                    return;
+                }
+                await Task.Delay(250, ct).ConfigureAwait(false);
+            }
+        }
+        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
+        catch
+        {
+            // A failed observer cannot leave an unmonitored fight running.
+            CancellationContext.Instance.Cancel();
+            throw;
+        }
+    }
+}
+
+public sealed class AgentPinnedRoutes
+{
+    private readonly Dictionary<string, byte[]> _resources;
+    private readonly CancellationToken _token;
+    internal bool Failed { get; private set; }
+    private readonly int _timedRouteThreshold;
+    private readonly Action<string>? _phase;
+    internal AgentPinnedRoutes(Dictionary<string, byte[]> resources, CancellationToken token, int timedRouteThreshold = 0,
+        Action<string>? phase = null)
+    { _resources = resources; _token = token; _timedRouteThreshold = AgentTimedRoutePolicy.Validate(timedRouteThreshold); _phase = phase; }
+
+    internal static PathingTask ParseResource(byte[] bytes)
+    {
+        // Pinned resources retain their original bytes and hash. As with
+        // File.ReadAllText, consume the optional UTF-8 BOM before JSON parsing.
+        var offset = bytes.AsSpan().StartsWith(new byte[] { 0xEF, 0xBB, 0xBF }) ? 3 : 0;
+        return PathingTask.BuildFromJson(new UTF8Encoding(false, true).GetString(bytes, offset, bytes.Length - offset));
+    }
+
+    public async Task RunFile(string path)
+    {
+        try
+        {
+            _token.ThrowIfCancellationRequested();
+            if (Failed) throw new InvalidOperationException("A previous commission route failed; rescan before retrying.");
+            var name = "autocommission/" + path.Replace('\\', '/');
+            if (!_resources.TryGetValue(name, out var bytes))
+                throw new InvalidDataException("Route is outside the pinned source pack.");
+            var route = ParseResource(bytes);
+            _phase?.Invoke("route");
+            var executor = new PathExecutor(_token);
+            executor.PartyConfig.VerifiedCommissionCombat = true;
+            // Optional looting previously consumed 45 seconds in this timed
+            // commission. The override belongs only to this executor instance.
+            executor.PartyConfig.SuppressOptionalBattleLoot =
+                name.StartsWith("autocommission/assets/极速前进/", StringComparison.Ordinal);
+            if (executor.PartyConfig.SuppressOptionalBattleLoot)
+                executor.PartyConfig.TimedRouteSkipCombatBelowSeconds = _timedRouteThreshold;
+            await executor.Pathing(route);
+            _token.ThrowIfCancellationRequested();
+            if (!executor.SuccessEnd) throw new InvalidOperationException("Route did not complete.");
+            _phase?.Invoke("verify");
+        }
+        catch { Failed = true; throw; }
+    }
+}
