--- /dev/null
+++ b/Test/BetterGenshinImpact.AgentBridge.Tests/AgentBridgeTests.cs
@@ -0,0 +1,241 @@
+using System.Buffers.Binary;
+using BetterGenshinImpact.AgentBridge;
+using Newtonsoft.Json.Linq;
+using Xunit;
+
+namespace BetterGenshinImpact.AgentBridge.Tests;
+
+public sealed class AgentBridgeTests
+{
+    private static readonly JObject Option = JObject.Parse("""
+        {"id":"talk","label":"Talk","skill":"dialogue.select","skill_version":"1",
+         "arguments":{"text":"Katheryne"},"preconditions":{"scene":"world","account_verified":true},
+         "ttl_ms":3000,"timeout_ms":30000}
+        """);
+
+    private sealed class Backend : IAgentGameBackend
+    {
+        internal JObject Scope = JObject.Parse("""{"account_id":"fixture","server_id":"fixture","game_day":"2026-10-18"}""");
+        internal JObject Facts = JObject.Parse("""{"scene":"world","account_verified":true}""");
+        internal readonly TaskCompletionSource Started = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        internal readonly TaskCompletionSource Cancelled = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        internal TaskCompletionSource? CaptureEntered;
+        internal TaskCompletionSource? FinishCapture;
+        internal int Calls;
+        internal int Releases;
+        internal bool ThrowOnRelease;
+
+        public async Task<GameObservation> CaptureAsync(CancellationToken cancellationToken)
+        {
+            if (CaptureEntered is not null)
+            {
+                CaptureEntered.TrySetResult();
+                await FinishCapture!.Task.WaitAsync(cancellationToken);
+            }
+            return new GameObservation((JObject)Scope.DeepClone(), (JObject)Facts.DeepClone(), []);
+        }
+
+        public async Task<SkillOutcome> ExecuteAsync(JObject option, CancellationToken cancellationToken)
+        {
+            Interlocked.Increment(ref Calls);
+            Started.TrySetResult();
+            using var registration = cancellationToken.Register(() => Cancelled.TrySetResult());
+            await Task.Delay(Timeout.Infinite, cancellationToken);
+            return new SkillOutcome("succeeded", "fixture", new JObject());
+        }
+
+        public void ReleaseInputs()
+        {
+            Interlocked.Increment(ref Releases);
+            if (ThrowOnRelease) throw new IOException("Fixture release failure");
+        }
+    }
+
+    private static JObject Command(JObject observation, string id = "command-1", JObject? option = null) => new()
+    {
+        ["command_id"] = id, ["request_id"] = "decision-1",
+        ["session_id"] = observation["session_id"]!.DeepClone(),
+        ["scope"] = observation["scope"]!.DeepClone(),
+        ["control_generation"] = observation["control_generation"]!.DeepClone(),
+        ["source_frame_id"] = observation["frame_id"]!.DeepClone(),
+        ["basis_hash"] = "fixture", ["catalog_hash"] = "fixture", ["remaining_ttl_ms"] = 3000,
+        ["option"] = option?.DeepClone() ?? Option.DeepClone(),
+        ["origin"] = "decision", ["action_granularity"] = "skill"
+    };
+
+    [Fact]
+    public async Task DeadlineCheckpointPreservesGenerationAndCannotUndoManualStop()
+    {
+        var backend = new Backend();
+        var option = (JObject)Option.DeepClone();
+        option["skill"] = "daily.execute";
+        option["timeout_ms"] = 100;
+        await using var host = new AgentCommandHost(backend, new JArray(option));
+        host.Arm();
+        var before = await host.ObserveAsync(CancellationToken.None);
+        await host.StartAsync(Command(before, option: option), CancellationToken.None);
+        await backend.Started.Task.WaitAsync(TimeSpan.FromSeconds(2));
+        Assert.Equal("checkpoint_before_deadline", host.Checkpoint("command-1").Value<string>("reason"));
+        await backend.Cancelled.Task.WaitAsync(TimeSpan.FromSeconds(2));
+        JObject result;
+        do
+        {
+            await Task.Delay(10);
+            result = host.Checkpoint("command-1");
+        } while (result.Value<string>("status") == "running");
+        Assert.Equal("cancelled", result.Value<string>("status"));
+        var after = await host.ObserveAsync(CancellationToken.None);
+        Assert.Equal(before.Value<long>("control_generation"), after.Value<long>("control_generation"));
+        Assert.True(backend.Releases > 0);
+        host.Stop();
+        Assert.Equal("unknown", host.Checkpoint("command-1").Value<string>("status"));
+        Assert.True((await host.ObserveAsync(CancellationToken.None)).Value<long>("control_generation")
+                    > before.Value<long>("control_generation"));
+    }
+
+    [Fact]
+    public async Task CheckpointRejectsOtherSkillsAndUnknownCommands()
+    {
+        var backend = new Backend();
+        await using var host = new AgentCommandHost(backend, new JArray(Option));
+        host.Arm();
+        var state = await host.ObserveAsync(CancellationToken.None);
+        await host.StartAsync(Command(state), CancellationToken.None);
+        Assert.Equal("unknown", host.Checkpoint("command-1").Value<string>("status"));
+        Assert.Equal("unknown", host.Checkpoint("missing").Value<string>("status"));
+        Assert.False(backend.Cancelled.Task.IsCompleted);
+    }
+
+    [Fact]
+    public async Task DuplicateCommandIsNotExecutedTwice()
+    {
+        var backend = new Backend();
+        await using var host = new AgentCommandHost(backend, new JArray(Option));
+        host.Arm();
+        var state = await host.ObserveAsync(CancellationToken.None);
+        var command = Command(state);
+        Assert.Equal("running", (await host.StartAsync(command, CancellationToken.None)).Value<string>("status"));
+        Assert.Equal("running", (await host.StartAsync(command, CancellationToken.None)).Value<string>("status"));
+        await backend.Started.Task.WaitAsync(TimeSpan.FromSeconds(2));
+        Assert.Equal(1, backend.Calls);
+        var changed = (JObject)command.DeepClone();
+        changed["option"]!["arguments"]!["text"] = "Another target";
+        await Assert.ThrowsAsync<ArgumentException>(() => host.StartAsync(changed, CancellationToken.None));
+    }
+
+    [Fact]
+    public async Task ChangedGuardOrActionArgumentsCannotExecute()
+    {
+        var backend = new Backend();
+        await using var host = new AgentCommandHost(backend, new JArray(Option));
+        host.Arm();
+        var state = await host.ObserveAsync(CancellationToken.None);
+        var changed = (JObject)Option.DeepClone();
+        changed["arguments"]!["text"] = "Another target";
+        Assert.Equal("cancelled", (await host.StartAsync(Command(state, option: changed), CancellationToken.None)).Value<string>("status"));
+        backend.Facts["scene"] = "map";
+        Assert.Equal("cancelled", (await host.StartAsync(Command(state), CancellationToken.None)).Value<string>("status"));
+        Assert.Equal(0, backend.Calls);
+    }
+
+    [Fact]
+    public async Task StopDuringCaptureInvalidatesQueuedCommandWithoutWaitingForCapture()
+    {
+        var backend = new Backend();
+        await using var host = new AgentCommandHost(backend, new JArray(Option));
+        host.Arm();
+        var state = await host.ObserveAsync(CancellationToken.None);
+        backend.CaptureEntered = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        backend.FinishCapture = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        var pending = host.StartAsync(Command(state), CancellationToken.None);
+        await backend.CaptureEntered.Task.WaitAsync(TimeSpan.FromSeconds(2));
+        host.Stop();
+        Assert.True(backend.Releases > 0);
+        backend.FinishCapture.TrySetResult();
+        Assert.Equal("cancelled", (await pending).Value<string>("status"));
+        Assert.Equal(0, backend.Calls);
+    }
+
+    [Fact]
+    public async Task OnlyOneInputLeaseCanExecute()
+    {
+        var backend = new Backend();
+        await using var host = new AgentCommandHost(backend, new JArray(Option));
+        host.Arm();
+        var state = await host.ObserveAsync(CancellationToken.None);
+        await host.StartAsync(Command(state), CancellationToken.None);
+        await backend.Started.Task.WaitAsync(TimeSpan.FromSeconds(2));
+        Assert.Equal("cancelled", (await host.StartAsync(Command(state, "second"), CancellationToken.None)).Value<string>("status"));
+        Assert.Equal(1, backend.Calls);
+        host.Stop();
+        await backend.Cancelled.Task.WaitAsync(TimeSpan.FromSeconds(2));
+        Assert.True(backend.Releases > 0);
+    }
+
+    [Fact]
+    public async Task AccountSwitchRequiresExplicitRearm()
+    {
+        var backend = new Backend();
+        await using var host = new AgentCommandHost(backend, new JArray(Option));
+        host.Arm();
+        var before = await host.ObserveAsync(CancellationToken.None);
+        backend.Scope["account_id"] = "other";
+        var after = await host.ObserveAsync(CancellationToken.None);
+        Assert.Empty(host.Candidates(after.Value<long>("frame_id")));
+        Assert.True(after.Value<long>("control_generation") > before.Value<long>("control_generation"));
+        Assert.Equal("cancelled", (await host.StartAsync(Command(before), CancellationToken.None)).Value<string>("status"));
+        Assert.Equal(0, backend.Calls);
+    }
+
+    [Fact]
+    public async Task LocalWatchdogCancelsWhenTheAgentStopsPolling()
+    {
+        var backend = new Backend();
+        await using var host = new AgentCommandHost(backend, new JArray(Option), TimeSpan.FromMilliseconds(50));
+        host.Arm();
+        var state = await host.ObserveAsync(CancellationToken.None);
+        await host.StartAsync(Command(state), CancellationToken.None);
+        await backend.Started.Task.WaitAsync(TimeSpan.FromSeconds(2));
+        await backend.Cancelled.Task.WaitAsync(TimeSpan.FromSeconds(2));
+        Assert.True(backend.Releases > 0);
+    }
+
+    [Fact]
+    public async Task SkillTimeoutIsEnforcedWithoutPython()
+    {
+        var backend = new Backend();
+        var option = (JObject)Option.DeepClone();
+        option["timeout_ms"] = 100;
+        await using var host = new AgentCommandHost(backend, new JArray(option));
+        host.Arm();
+        var state = await host.ObserveAsync(CancellationToken.None);
+        await host.StartAsync(Command(state, option: option), CancellationToken.None);
+        await backend.Started.Task.WaitAsync(TimeSpan.FromSeconds(2));
+        await backend.Cancelled.Task.WaitAsync(TimeSpan.FromSeconds(2));
+        Assert.True(backend.Releases > 0);
+    }
+
+    [Fact]
+    public async Task FailedInputReleasePreventsRearming()
+    {
+        var backend = new Backend { ThrowOnRelease = true };
+        await using var host = new AgentCommandHost(backend, new JArray(Option));
+        host.Stop();
+        Assert.Throws<InvalidOperationException>(() => host.Arm());
+    }
+
+    [Fact]
+    public async Task FramingPreservesUnicodeAndRejectsTruncatedOrOversizedPayloads()
+    {
+        await using var stream = new MemoryStream();
+        var message = new JObject { ["text"] = "领取每日奖励", ["value"] = 0, ["unknown"] = null };
+        await AgentPipeProtocol.WriteAsync(stream, message, CancellationToken.None);
+        stream.Position = 0;
+        Assert.True(JToken.DeepEquals(message, await AgentPipeProtocol.ReadAsync(stream, CancellationToken.None)));
+        var header = new byte[4];
+        BinaryPrimitives.WriteInt32LittleEndian(header, AgentPipeProtocol.MaxPayloadBytes + 1);
+        await Assert.ThrowsAsync<InvalidDataException>(() => AgentPipeProtocol.ReadAsync(new MemoryStream(header), CancellationToken.None));
+        BinaryPrimitives.WriteInt32LittleEndian(header, 10);
+        await Assert.ThrowsAsync<EndOfStreamException>(() => AgentPipeProtocol.ReadAsync(new MemoryStream(header), CancellationToken.None));
+    }
+}
