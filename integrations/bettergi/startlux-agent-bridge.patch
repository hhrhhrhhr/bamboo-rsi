@@ -0,0 +1,57 @@
+using System.IO;
+using BetterGenshinImpact.Service.Agent;
+using Newtonsoft.Json.Linq;
+using Xunit;
+
+public class AgentJournalRowsTests
+{
+    private static JArray Rows(params string[] names) => new(names.Select((name, index) =>
+        new JObject { ["id"] = index + 1, ["name"] = name, ["location"] = "Mondstadt" }));
+
+    private static Dictionary<int, JObject> Evidence(int completeSlot) => Enumerable.Range(1, 4)
+        .ToDictionary(slot => slot, slot => new JObject { ["completed"] = slot == completeSlot,
+            ["evidence"] = new JObject { ["screenshot_sha256"] = $"frame-{slot}" } });
+
+    [Fact]
+    public void CompletedQuestMovingToTheBottomKeepsItsIdentityAndOwnScreenshot()
+    {
+        var previous = Rows("A", "B", "C", "D");
+        var observed = Rows("B", "C", "D", "A");
+        var observations = Evidence(4);
+        var bound = AgentJournalRows.Bind(previous, observed, observations);
+        Assert.Equal(new[] { "A", "B", "C", "D" }, bound.Rows.Select(r => r.Value<string>("name")));
+        Assert.Equal("1:A", bound.Evidence[1].Value<string>("quest_id"));
+        Assert.True(bound.Evidence[1].Value<bool>("completed"));
+        Assert.Equal("frame-4", bound.Evidence[1]["evidence"]!.Value<string>("screenshot_sha256"));
+        Assert.False(bound.Evidence[2].Value<bool>("completed"));
+        Assert.Equal("frame-1", bound.Evidence[2]["evidence"]!.Value<string>("screenshot_sha256"));
+        Assert.Null(observations[4]["quest_id"]);
+        Assert.Equal("B", observed[0].Value<string>("name"));
+    }
+
+    [Fact]
+    public void FirstScanAssignsStableIdentities()
+    {
+        var bound = AgentJournalRows.Bind(new JArray(), Rows("A", "B", "C", "D"), Evidence(4));
+        Assert.Equal("4:D", bound.Evidence[4].Value<string>("quest_id"));
+        Assert.True(bound.Evidence[4].Value<bool>("completed"));
+    }
+
+    [Theory]
+    [InlineData("A", "B", "C", "unknown")]
+    [InlineData("A", "B", "C", "C")]
+    public void ChangedOrAmbiguousIdentitiesCannotReassignCompletion(string a, string b, string c, string d)
+    {
+        var previous = Rows("A", "B", "C", "D");
+        Assert.Throws<InvalidDataException>(() => AgentJournalRows.Bind(previous, Rows(a, b, c, d), Evidence(4)));
+        Assert.Equal("D", previous[3].Value<string>("name"));
+    }
+
+    [Fact]
+    public void MissingVisualStatusCannotPublishAPartialSnapshot()
+    {
+        var observations = Evidence(4);
+        observations.Remove(2);
+        Assert.Throws<InvalidDataException>(() => AgentJournalRows.Bind(new JArray(), Rows("A", "B", "C", "D"), observations));
+    }
+}
