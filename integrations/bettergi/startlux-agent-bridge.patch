+using BetterGenshinImpact.Service.Agent;
+using Xunit;
+
+namespace BetterGenshinImpact.AgentBridge.Tests;
+
+public class AgentFlightInputTests
+{
+    [Fact]
+    public void MissingHintCannotRapidlyToggleGlider()
+    {
+        var input = new AgentFlightInput();
+        Assert.True(input.ShouldOpen(false, 0));
+        Assert.False(input.ShouldOpen(false, 300));
+        Assert.False(input.ShouldOpen(true, 500));
+        Assert.False(input.ShouldOpen(false, 1000)); // one bad frame
+        Assert.True(input.ShouldOpen(false, 1200));
+        Assert.False(input.ShouldOpen(false, 1300));
+        Assert.False(input.ShouldOpen(true, 1500));
+    }
+
+    [Fact]
+    public async Task PulseSpansFramesAndWaitsForFreshCapture()
+    {
+        var calls = new List<string>();
+        await AgentFlightInput.Pulse(() => calls.Add("down"), () => calls.Add("up"),
+            (ms, ct) => { calls.Add(ms.ToString()); return Task.CompletedTask; }, default);
+        Assert.Equal(new[] { "down", "100", "up", "300" }, calls);
+    }
+
+    [Fact]
+    public async Task CancellationReleasesHeldInput()
+    {
+        var calls = new List<string>();
+        using var source = new CancellationTokenSource();
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() => AgentFlightInput.Pulse(
+            () => calls.Add("down"), () => calls.Add("up"),
+            (ms, ct) => { source.Cancel(); ct.ThrowIfCancellationRequested(); return Task.CompletedTask; }, source.Token));
+        Assert.Equal(new[] { "down", "up" }, calls);
+    }
+
+    [Fact]
+    public async Task AlreadyCancelledNeverPresses()
+    {
+        var calls = new List<string>();
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() => AgentFlightInput.Pulse(
+            () => calls.Add("down"), () => calls.Add("up"), Task.Delay, new CancellationToken(true)));
+        Assert.Empty(calls);
+    }
+}
