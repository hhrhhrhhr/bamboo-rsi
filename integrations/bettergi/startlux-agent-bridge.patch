+using BetterGenshinImpact.Service.Agent;
+using Xunit;
+
+public class AgentUidRecognitionTests
+{
+    [Theory]
+    [InlineData("UID:123456789")]
+    [InlineData("Q\nE\nUD:123456789")]
+    [InlineData("U1D：123456789")]
+    [InlineData("U I D 123456789")]
+    public void FocusedBannerRetainsExactDigits(string text)
+    {
+        var result = AgentUidRecognition.Read(text, "");
+        Assert.Equal("123456789", result.AccountId);
+        Assert.Equal("bottom_right_ocr", result.Source);
+    }
+
+    [Theory]
+    [InlineData("123456789")]
+    [InlineData("UID:1234567")]
+    [InlineData("UID:12345678999")]
+    [InlineData("GUID:123456789")]
+    public void UnlabelledOrInvalidNumbersCannotVerifyAnAccount(string text)
+        => Assert.Null(AgentUidRecognition.Read(text, "").AccountId);
+
+    [Fact]
+    public void ConflictingFocusedBannersDoNotUseAConvenientFallback()
+        => Assert.Null(AgentUidRecognition.Read("UID:123456789\nUID:999999999", "UID:123456789").AccountId);
+
+    [Fact]
+    public void ActiveAccountBannerTakesPrecedenceOverAnotherProfileInTheFullFrame()
+        => Assert.Equal("123456789", AgentUidRecognition.Read("UID:123456789", "UID:999999999").AccountId);
+
+    [Fact]
+    public void FullFrameFallbackRequiresOneUnambiguousLabelledUid()
+    {
+        Assert.Equal("full_frame_ocr", AgentUidRecognition.Read("", "UID:123456789").Source);
+        Assert.Null(AgentUidRecognition.Read("", "UID:123456789\nUID:999999999").AccountId);
+    }
+}
