@@ -0,0 +1,34 @@
+using System;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace BetterGenshinImpact.Service.Agent;
+
+/// <summary>Frame-visible flight input with debounce; the UI hint is not a wing detector.</summary>
+internal sealed class AgentFlightInput
+{
+    private long _lastPulse = long.MinValue;
+    private int _missing;
+    private bool _seenAirborne;
+
+    internal bool ShouldOpen(bool airborne, long milliseconds)
+    {
+        if (airborne) { _seenAirborne = true; _missing = 0; return false; }
+        _missing++;
+        if (_seenAirborne && _missing < 2) return false;
+        if (_lastPulse != long.MinValue && milliseconds - _lastPulse < 700) return false;
+        _lastPulse = milliseconds;
+        _missing = 0;
+        return true;
+    }
+
+    internal static async Task Pulse(Action down, Action up, Func<int, CancellationToken, Task> delay,
+        CancellationToken ct)
+    {
+        ct.ThrowIfCancellationRequested();
+        try { down(); await delay(100, ct); }
+        finally { up(); }
+        // Input and captured frames lag the game. Never inspect the pre-input frame.
+        await delay(300, ct);
+    }
+}
diff --git a/BetterGenshinImpact/Service/Agent/AgentGoalMemory.cs b/BetterGenshinImpact/Service/Agent/AgentGoalMemory.cs
new file mode 100644
index 0000000..3af2f2d
--- /dev/null
+++ b/BetterGenshinImpact/Service/Agent/AgentGoalMemory.cs
@@ -0,0 +1,123 @@
+using System;
+using System.IO;
+using System.Linq;
+using System.Security.Cryptography;
+using System.Text;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+
+namespace BetterGenshinImpact.Service.Agent;
+
+// Mutable evidence, never a completion oracle. Reserve durably BEFORE input;
+// an interrupted process consumes its reservation rather than granting a retry.
+public sealed class AgentGoalMemory
+{
+    private readonly string _root;
+    private readonly string _version;
+    private readonly string _run;
+    private JObject? _scope;
+    private string? _path;
+    public AgentGoalMemory(string root, string version, string run)
+    {
+        if (version.Length != 64 || version.Any(c => !Uri.IsHexDigit(c)) || string.IsNullOrWhiteSpace(run))
+            throw new InvalidDataException("Goal memory requires a bound program version and run.");
+        _root = Path.GetFullPath(root); _version = version; _run = run;
+        Directory.CreateDirectory(_root);
+        RejectLink(_root);
+    }
+    private static void RejectLink(string path)
+    {
+        if (File.Exists(path) || Directory.Exists(path))
+            if ((File.GetAttributes(path) & FileAttributes.ReparsePoint) != 0)
+                throw new InvalidDataException("Goal memory cannot contain links.");
+    }
+    public void Bind(JObject scope)
+    {
+        if (_scope != null && !JToken.DeepEquals(_scope, scope))
+            throw new InvalidOperationException("Goal memory account or game day changed.");
+        _scope = (JObject)scope.DeepClone();
+        var identity = new JObject { ["account_id"] = scope["account_id"],
+            ["server_id"] = scope["server_id"], ["game_day"] = scope["game_day"] };
+        if (identity.Properties().Any(p => p.Value.Type != JTokenType.String || string.IsNullOrWhiteSpace((string?)p.Value)))
+            throw new InvalidDataException("Incomplete goal memory scope.");
+        _path = Path.Combine(_root, Convert.ToHexString(SHA256.HashData(
+            Encoding.UTF8.GetBytes(identity.ToString(Formatting.None)))).ToLowerInvariant() + ".json");
+        Read(); // Corruption fails closed before any game input.
+    }
+    private JObject Read()
+    {
+        if (_path == null || _scope == null) throw new InvalidOperationException("Goal memory is not bound.");
+        RejectLink(_path);
+        if (!File.Exists(_path)) return new JObject { ["schema_version"] = 1,
+            ["scope"] = _scope.DeepClone(), ["attempts"] = new JArray() };
+        if (new FileInfo(_path).Length > 1024 * 1024) throw new InvalidDataException("Goal memory is too large.");
+        var data = JObject.Parse(File.ReadAllText(_path));
+        if (data.Value<int>("schema_version") != 1 || !JToken.DeepEquals(data["scope"], _scope)
+            || data["attempts"] is not JArray attempts || attempts.Count > 8
+            || attempts.Any(a => string.IsNullOrWhiteSpace(a.Value<string>("quest"))
+                || a.Value<string>("status") is not ("reserved" or "incomplete" or "completed")
+                || string.IsNullOrWhiteSpace(a.Value<string>("id")))
+            || attempts.Select(a => a.Value<string>("id")).Distinct().Count() != attempts.Count
+            || attempts.GroupBy(a => a.Value<string>("quest")).Any(g => g.Count() > 2))
+            throw new InvalidDataException("Goal memory is invalid; preserve it for review.");
+        return data;
+    }
+    private void Write(JObject data)
+    {
+        var temporary = _path + "." + Guid.NewGuid().ToString("N") + ".tmp";
+        using (var stream = new FileStream(temporary, FileMode.CreateNew, FileAccess.Write, FileShare.None))
+        {
+            var bytes = Encoding.UTF8.GetBytes(data.ToString(Formatting.Indented));
+            stream.Write(bytes); stream.Flush(true);
+        }
+        File.Move(temporary, _path!, true);
+    }
+    private FileStream Lease()
+    {
+        RejectLink(_root); RejectLink(Path.Combine(_root, "memory.lock"));
+        return new FileStream(Path.Combine(_root, "memory.lock"), FileMode.OpenOrCreate, FileAccess.ReadWrite, FileShare.None);
+    }
+    public JArray History(string quest) => new(Read()["attempts"]!.Where(a => a.Value<string>("quest") == quest)
+        .Select(a => a.DeepClone()));
+    public void BindRoster(string[] quests)
+    {
+        using var lease = Lease();
+        var data = Read();
+        if (quests.Length != 4 || quests.Distinct(StringComparer.Ordinal).Count() != 4)
+            throw new InvalidDataException("Four unique daily quests are required.");
+        if (data["quests"] is JArray previous && !previous.Values<string>().Order().SequenceEqual(quests.Order()))
+            throw new InvalidDataException("Persisted daily quest identities changed; review is required.");
+        data["quests"] = new JArray(quests); Write(data);
+    }
+    public int Used(string quest) => History(quest).Count;
+    public bool CanUseDefault(string quest)
+    {
+        var history = History(quest);
+        return history.Count == 0 || history.Count < 2 && history.Last!.Value<string>("version") != _version;
+    }
+    public string Reserve(string quest, string location, string strategy)
+    {
+        using var lease = Lease();
+        var data = Read(); var attempts = (JArray)data["attempts"]!;
+        if (data["quests"] is not JArray roster || !roster.Values<string>().Contains(quest))
+            throw new InvalidDataException("Attempt does not belong to the verified daily roster.");
+        if (attempts.Count >= 8 || attempts.Count(a => a.Value<string>("quest") == quest) >= 2)
+            throw new InvalidOperationException("Commission daily attempt budget exhausted.");
+        var id = Guid.NewGuid().ToString("N");
+        attempts.Add(new JObject { ["id"] = id, ["quest"] = quest, ["location"] = location,
+            ["version"] = _version, ["run"] = _run, ["strategy"] = strategy,
+            ["status"] = "reserved", ["reserved_at"] = DateTimeOffset.UtcNow });
+        Write(data); return id;
+    }
+    public void Verify(string id, bool completed)
+    {
+        using var lease = Lease();
+        var data = Read();
+        var attempt = data["attempts"]!.Single(a => a.Value<string>("id") == id);
+        if (attempt.Value<string>("status") != "reserved")
+            throw new InvalidOperationException("Attempt already resolved.");
+        attempt["status"] = completed ? "completed" : "incomplete";
+        attempt["verified_at"] = DateTimeOffset.UtcNow;
+        Write(data);
+    }
+}
diff --git a/BetterGenshinImpact/Service/Agent/AgentGoalProgress.cs b/BetterGenshinImpact/Service/Agent/AgentGoalProgress.cs
new file mode 100644
index 0000000..7a63388
--- /dev/null
+++ b/BetterGenshinImpact/Service/Agent/AgentGoalProgress.cs
@@ -0,0 +1,89 @@
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Linq;
+using Newtonsoft.Json.Linq;
+
+namespace BetterGenshinImpact.Service.Agent;
+
+// Only a new journal observation resolves an attempt. Persisted reservations
+// survive process restarts and version changes; old completion is never reused.
+public sealed class AgentGoalProgress
+{
+    private readonly Dictionary<int, int> _failures = new();
+    private readonly Dictionary<int, JObject> _rows = new();
+    private readonly AgentGoalMemory? _memory;
+    private string? _reservation;
+    private int? _pending;
+    private int? _localRecovery;
+    private string? _quest;
+    private string _phase = "idle";
+    private int _revision;
+    private readonly Stopwatch _phaseClock = Stopwatch.StartNew();
+    private JObject? _last;
+    public AgentGoalProgress(AgentGoalMemory? memory = null) { _memory = memory; }
+    public void BindScope(JObject scope) => _memory?.Bind(scope);
+    public void BindRows(JArray rows)
+    {
+        _memory?.BindRoster(rows.Select(r => r.Value<string>("name")!).ToArray());
+        _rows.Clear();
+        foreach (var row in rows.Cast<JObject>()) _rows.Add(row.Value<int>("id"), (JObject)row.DeepClone());
+    }
+    private string Name(int slot) => _rows.TryGetValue(slot, out var row) ? row.Value<string>("name")! : "";
+    public bool Available(int slot) => _memory == null ? _failures.GetValueOrDefault(slot) < 2
+        : _rows.ContainsKey(slot) && _memory.Used(Name(slot)) < 2 && _memory.CanUseDefault(Name(slot));
+    public bool CanRetry(int slot) => _memory != null && _rows.ContainsKey(slot)
+        && _memory.Used(Name(slot)) == 1 && _memory.History(Name(slot)).Last!.Value<string>("status") != "completed";
+    public bool LocalRecovery(int slot) => CanRetry(slot) && _localRecovery == slot
+        && !Name(slot).Contains("极速前进", StringComparison.Ordinal);
+    public bool TimedRoute => _quest?.Contains("极速前进", StringComparison.Ordinal) == true;
+    public void Begin(int slot, string name, string strategy = "default")
+    {
+        if (strategy is not ("default" or "ranged" or "reposition_left" or "reposition_right" or "heal_retry"))
+            throw new ArgumentException("Unknown bounded retry strategy.");
+        var available = strategy == "default" ? Available(slot)
+            : strategy == "heal_retry" ? CanRetry(slot) : LocalRecovery(slot);
+        if (slot is < 1 or > 4 || _pending != null || !available || _memory != null && name != Name(slot))
+            throw new InvalidOperationException("Commission requires verification or has exhausted its daily attempts.");
+        _reservation = _memory?.Reserve(name, _rows[slot].Value<string>("location") ?? "", strategy);
+        _pending = slot; _localRecovery = null;
+        _quest = $"{slot}:{name}";
+        Phase("prepare");
+    }
+    public void Phase(string phase)
+    {
+        if (phase is not ("prepare" or "route" or "interact" or "recover" or "verify" or "idle"))
+            throw new ArgumentException("Unknown commission phase.");
+        _phase = phase;
+        _revision++; _phaseClock.Restart();
+    }
+    public void Verify(bool completed)
+    {
+        if (_pending is not int slot) return;
+        if (_reservation != null) _memory!.Verify(_reservation, completed);
+        if (!completed) _failures[slot] = _failures.GetValueOrDefault(slot) + 1;
+        _last = new JObject { ["quest_id"] = _quest, ["completed"] = completed,
+            ["failed_attempts"] = Failures(slot), ["deferred"] = !Available(slot) && !CanRetry(slot) };
+        _localRecovery = completed ? null : slot;
+        _pending = null; _reservation = null; _quest = null;
+        Phase("idle");
+    }
+    private int Failures(int slot) => _memory == null ? _failures.GetValueOrDefault(slot)
+        : _memory.History(Name(slot)).Count(a => a.Value<string>("status") != "completed"
+            && (a.Value<string>("status") != "reserved" || a.Value<string>("id") != _reservation));
+    public JObject Snapshot()
+    {
+        var history = new JObject(); var failures = JObject.FromObject(_failures);
+        if (_memory != null)
+            foreach (var slot in _rows.Keys)
+            { history[slot.ToString()] = _memory.History(Name(slot)); failures[slot.ToString()] = Failures(slot); }
+        return new JObject
+        {
+        ["active_quest_id"] = _quest, ["phase"] = _phase, ["phase_revision"] = _revision,
+        ["phase_elapsed_seconds"] = Math.Round(_phaseClock.Elapsed.TotalSeconds, 1),
+        ["failed_attempts_by_slot"] = failures, ["attempt_history_by_slot"] = history,
+        ["last_verification"] = _last?.DeepClone(), ["attempt_limit_per_quest"] = 2,
+        ["failure_budget_scope"] = _memory == null ? "execution_session" : "account_server_game_day_quest_across_versions"
+        };
+    }
+}
