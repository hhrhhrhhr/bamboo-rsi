+using BetterGenshinImpact.Service.Agent;
+using Xunit;
+namespace BetterGenshinImpact.AgentBridge.Tests;
+public sealed class AgentProgressSamplesTests
+{
+    [Fact]
+    public void StaticFramesAreOnlyACueAndGapsOrPhaseChangesClearIt()
+    {
+        var samples = new AgentProgressSamples(); var pixels = new byte[32 * 18];
+        samples.Observe("route", 0, pixels);
+        var fast = samples.Observe("route", 100, pixels);
+        Assert.Equal(1, fast.Value<int>("sample_count"));
+        var slow = samples.Observe("route", 5000, pixels);
+        Assert.Equal(5, slow.Value<double>("similar_world_seconds"));
+        Assert.Equal(Newtonsoft.Json.Linq.JTokenType.Null, slow["enemy_hp_fraction"]!.Type);
+        Assert.Equal(0, samples.Observe("route", 30000, pixels).Value<double>("similar_world_seconds"));
+        samples.Observe("route", 35000, pixels);
+        Assert.Equal(0, samples.Observe("interact", 40000, pixels).Value<double>("similar_world_seconds"));
+        Assert.Equal(0, samples.Observe("interact", 45000, Enumerable.Repeat((byte)200, 32 * 18).ToArray()).Value<double>("similar_world_seconds"));
+    }
+    [Fact]
+    public void RecoveryCatalogAlwaysRequiresCurrentGroundAndNeverOffersRawKeys()
+    {
+        var options = AgentRecoveryActions.Catalog(); Assert.Equal(16, options.Count);
+        Assert.Equal(16, options.Select(o => o.Value<string>("id")).Distinct().Count());
+        foreach (var option in options)
+        {
+            Assert.Equal("daily.recover", option.Value<string>("skill"));
+            Assert.True(option["preconditions"]!.Value<bool>("daily_recovery_grounded"));
+            Assert.True(option["preconditions"]!.Value<bool>("foreground"));
+            Assert.True(option["preconditions"]!.Value<bool>("account_verified"));
+            Assert.False(option["preconditions"]!.Value<bool>("daily_needs_scan"));
+            Assert.Equal(2, ((Newtonsoft.Json.Linq.JObject)option["arguments"]!).Count);
+        }
+    }
+}
