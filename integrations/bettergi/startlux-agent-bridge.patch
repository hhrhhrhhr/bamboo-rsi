@@ -0,0 +1,55 @@
+using BetterGenshinImpact.Service.Agent;
+using Newtonsoft.Json.Linq;
+using OpenCvSharp;
+using Xunit;
+
+public class AgentVideoRecorderTests
+{
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public async Task FinalizesDecodableVideoOnStopOrCaptureFailure(bool fail)
+    {
+        // Synthetic encoder/lifecycle test, never real gameplay acceptance evidence.
+        var directory = Path.Combine(Path.GetTempPath(), "startlux-video-" + Guid.NewGuid());
+        var captures = 0;
+        await using var video = new AgentVideoRecorder(directory, () =>
+        {
+            if (Interlocked.Increment(ref captures) > 3 && fail)
+                throw new AgentRecordingForegroundLostException();
+            return new Mat(72, 128, MatType.CV_8UC3, new Scalar(20, 120, 200));
+        });
+        var failures = 0;
+        video.Failed += () => Interlocked.Increment(ref failures);
+        video.Start();
+        var deadline = DateTime.UtcNow.AddSeconds(15);
+        while (Volatile.Read(ref captures) < 4 && DateTime.UtcNow < deadline) await Task.Delay(50);
+        Assert.True(captures >= 4);
+        if (!fail) File.WriteAllText(Path.Combine(directory, "stop"), "");
+        JObject? metadata = null;
+        while (DateTime.UtcNow < deadline)
+        {
+            var path = Path.Combine(directory, "recording.json");
+            if (File.Exists(path))
+            {
+                metadata = JObject.Parse(File.ReadAllText(path));
+                if (metadata.Value<string>("status") is "stopped" or "failed") break;
+            }
+            await Task.Delay(50);
+        }
+        Assert.Equal(fail ? "failed" : "stopped", metadata?.Value<string>("status"));
+        var clip = Assert.Single((JArray)metadata!["clips"]!);
+        Assert.True(clip.Value<bool>("decode_verified"));
+        Assert.True(clip.Value<int>("frames") >= 3);
+        Assert.True(new FileInfo(Path.Combine(directory, clip.Value<string>("path")!)).Length > 100);
+        // The failure callback stops the native input lease, independently of the model request.
+        if (fail)
+        {
+            Assert.Equal("game_foreground_lost", metadata.Value<string>("error_code"));
+            Assert.Equal("game_capture", metadata.Value<string>("error_stage"));
+            while (Volatile.Read(ref failures) == 0 && DateTime.UtcNow < deadline) await Task.Delay(10);
+            Assert.Equal(1, failures);
+        }
+        else Assert.Equal(0, failures);
+    }
+}
