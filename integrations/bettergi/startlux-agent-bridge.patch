+internal sealed class FixtureBackend : IAgentGameBackend
+{
+    private readonly object _gate = new();
+    private int _executions;
+
+    public Task<GameObservation> CaptureAsync(CancellationToken cancellationToken)
+    {
+        lock (_gate)
+        {
+            var scope = JObject.Parse("""{"account_id":"fixture-account","server_id":"fixture-server","game_day":"2026-10-18"}""");
+            var facts = new JObject { ["scene"] = "world", ["target"] = _executions == 0 ? "katheryne" : "none",
+                                      ["region"] = "mondstadt" };
+            return Task.FromResult(new GameObservation(scope, facts, []));
+        }
+    }
+
+    public Task<SkillOutcome> ExecuteAsync(JObject option, CancellationToken cancellationToken)
+    {
+        cancellationToken.ThrowIfCancellationRequested();
