@@ -0,0 +1,24 @@
+using System;
+using System.Linq;
+using System.Text.RegularExpressions;
+
+namespace BetterGenshinImpact.Service.Agent;
+
+internal static class AgentUidRecognition
+{
+    internal static (string? AccountId, string Source) Read(string focusedText, string fullText)
+    {
+        // In the dedicated bottom-right region Paddle may omit the narrow I.
+        // Digits must remain exact; bare numbers are never an account identity.
+        var focused = Extract(focusedText, @"\bU\s*[I1l|]?\s*D\s*[:：]?\s*(\d{8,10})(?!\d)");
+        if (focused.Length == 1) return (focused[0], "bottom_right_ocr");
+        if (focused.Length > 1) return (null, "conflicting_uid");
+        var fallback = Extract(fullText, @"\bUID\s*[:：]?\s*(\d{8,10})(?!\d)");
+        return fallback.Length == 1 ? (fallback[0], "full_frame_ocr")
+            : (null, fallback.Length > 1 ? "conflicting_uid" : "unreadable");
+    }
+
+    private static string[] Extract(string text, string pattern) => Regex.Matches(text, pattern,
+        RegexOptions.IgnoreCase | RegexOptions.CultureInvariant).Cast<Match>()
+        .Select(match => match.Groups[1].Value).Distinct(StringComparer.Ordinal).ToArray();
+}
diff --git a/BetterGenshinImpact/Service/Agent/AgentVideoRecorder.cs b/BetterGenshinImpact/Service/Agent/AgentVideoRecorder.cs
new file mode 100644
index 0000000..d2ef6fd
--- /dev/null
+++ b/BetterGenshinImpact/Service/Agent/AgentVideoRecorder.cs
@@ -0,0 +1,174 @@
+using System;
+using System.Diagnostics;
+using System.IO;
+using System.Security.Cryptography;
+using System.Threading;
+using System.Threading.Tasks;
+using Newtonsoft.Json.Linq;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.Service.Agent;
+
+internal sealed class AgentRecordingForegroundLostException : InvalidOperationException { }
+
+/// <summary>Game frames only, no audio/input. Finalize independent one-minute clips.</summary>
+internal sealed class AgentVideoRecorder(string directory, Func<Mat> capture) : IAsyncDisposable
+{
+    private const int Fps = 10;
+    private readonly CancellationTokenSource _stop = new();
+    private readonly JArray _clips = new();
+    private Task? _task;
+    private readonly object _gate = new();
+    private readonly DateTimeOffset _started = DateTimeOffset.UtcNow;
+    private long _frames;
+    private string? _error;
+    private string? _errorCode;
+    private string _stage = "starting";
+    internal event Action? Failed;
+
+    internal void Start()
+    {
+        lock (_gate)
+        {
+            if (_task != null) return;
+            Directory.CreateDirectory(directory);
+            _task = Task.Run(RecordAsync);
+        }
+    }
+
+    private void Status(string status)
+    {
+        var value = new JObject
+        {
+            ["schema_version"] = 1, ["status"] = status, ["source"] = "bettergi_game_window",
+            ["audio"] = false, ["fps"] = Fps, ["width"] = 1280, ["height"] = 720,
+            ["started_at"] = _started, ["updated_at"] = DateTimeOffset.UtcNow,
+            ["frames"] = _frames, ["clips"] = _clips.DeepClone(), ["error_type"] = _error,
+            ["error_code"] = _errorCode, ["error_stage"] = _error == null ? null : _stage
+        };
+        var path = Path.Combine(directory, "recording.json");
+        File.WriteAllText(path + ".tmp", value.ToString());
+        File.Move(path + ".tmp", path, true);
+    }
+
+    private async Task RecordAsync()
+    {
+        VideoWriter? writer = null;
+        string? path = null;
+        var framesInClip = 0;
+        var clipStarted = DateTimeOffset.UtcNow;
+        var clock = Stopwatch.StartNew();
+        var nextFrame = TimeSpan.Zero;
+        var status = "stopped";
+        try
+        {
+            using var timeline = new StreamWriter(Path.Combine(directory, "timeline.jsonl"), false);
+            while (!_stop.IsCancellationRequested && !File.Exists(Path.Combine(directory, "stop")))
+            {
+                if (clock.Elapsed > TimeSpan.FromHours(2))
+                    throw new TimeoutException("Recording lifetime exceeded.");
+                if (writer == null)
+                {
+                    _stage = "encoder_start";
+                    path = Path.Combine(directory, $"game-{_clips.Count + 1:D4}.mp4");
+                    if (File.Exists(path)) throw new IOException("Recording file already exists.");
+                    writer = new VideoWriter(path, VideoCaptureAPIs.FFMPEG,
+                        VideoWriter.FourCC('m', 'p', '4', 'v'), Fps, new Size(1280, 720));
+                    if (!writer.IsOpened()) throw new IOException("Video encoder could not start.");
+                    framesInClip = 0;
+                    clipStarted = DateTimeOffset.UtcNow;
+                }
+                _stage = "game_capture";
+                using var raw = capture();
+                if (raw.Empty()) throw new InvalidDataException("Empty game capture.");
+                using var bgr = new Mat();
+                _stage = "frame_encode";
+                if (raw.Channels() == 4) Cv2.CvtColor(raw, bgr, ColorConversionCodes.BGRA2BGR);
+                else if (raw.Channels() == 3) raw.CopyTo(bgr);
+                else throw new InvalidDataException("Unexpected game capture format.");
+                using var frame = new Mat();
+                Cv2.Resize(bgr, frame, new Size(1280, 720));
+                writer.Write(frame);
+                framesInClip++;
+                _frames++;
+                if (_frames % Fps == 1)
+                {
+                    _stage = "metadata_write";
+                    timeline.WriteLine(new JObject { ["frame"] = _frames,
+                        ["at"] = DateTimeOffset.UtcNow, ["elapsed_ms"] = clock.ElapsedMilliseconds }.ToString(Newtonsoft.Json.Formatting.None));
+                    timeline.Flush();
+                    Status("recording");
+                }
+                if (framesInClip >= Fps * 60)
+                {
+                    _stage = "clip_finalize";
+                    writer.Dispose();
+                    writer = null;
+                    FinalizeClip(path!, framesInClip, clipStarted);
+                }
+                nextFrame += TimeSpan.FromSeconds(1.0 / Fps);
+                // Never burst-capture to conceal a stall. The timeline preserves timing gaps.
+                if (nextFrame < clock.Elapsed) nextFrame = clock.Elapsed;
+                var delay = nextFrame - clock.Elapsed;
+                await Task.Delay(delay > TimeSpan.Zero ? delay : TimeSpan.Zero, _stop.Token).ConfigureAwait(false);
+            }
+        }
+        catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
+        catch (Exception error)
+        {
+            _error = error.GetType().Name;
+            _errorCode = error is AgentRecordingForegroundLostException ? "game_foreground_lost" : "recording_operation_failed";
+            status = "failed";
+        }
+        finally
+        {
+            try
+            {
+                if (writer != null)
+                {
+                    writer.Dispose();
+                    if (framesInClip > 0) FinalizeClip(path!, framesInClip, clipStarted);
+                }
+            }
+            catch (Exception error)
+            {
+                // Preserve the original cause when finalizing an already failed recording.
+                if (_error == null)
+                { _error = error.GetType().Name; _errorCode = "clip_finalization_failed"; _stage = "clip_finalize"; }
+                status = "failed";
+            }
+            try { Status(status); } catch (IOException) { /* Never impede input release. */ }
+            if (status == "failed") Failed?.Invoke();
+        }
+    }
+
+    private void FinalizeClip(string path, int frames, DateTimeOffset started)
+    {
+        // Verify a finalized container, including the last frame, before claiming a clip.
+        using var reader = new VideoCapture(path, VideoCaptureAPIs.FFMPEG);
+        using var decoded = new Mat();
+        if (!reader.IsOpened() || !reader.Read(decoded) || decoded.Empty()
+            || !reader.Set(VideoCaptureProperties.PosFrames, frames - 1)
+            || !reader.Read(decoded) || decoded.Empty())
+            throw new InvalidDataException("Finalized video could not be decoded.");
+        using var stream = File.OpenRead(path);
+        _clips.Add(new JObject { ["path"] = Path.GetFileName(path), ["frames"] = frames,
+            ["started_at"] = started, ["ended_at"] = DateTimeOffset.UtcNow,
+            ["duration_seconds"] = frames / (double)Fps, ["bytes"] = stream.Length,
+            ["sha256"] = Convert.ToHexString(SHA256.HashData(stream)).ToLowerInvariant(),
+            ["decode_verified"] = true });
+    }
+
+    public async ValueTask DisposeAsync()
+    {
+        _stop.Cancel();
+        Task? task;
+        lock (_gate) task = _task;
+        if (task != null)
+        {
+            try { await task.WaitAsync(TimeSpan.FromSeconds(10)).ConfigureAwait(false); }
+            catch (TimeoutException) { return; } // Keep the worker's CTS alive until process exit.
+        }
+        _stop.Dispose();
+    }
+}
diff --git a/BetterGenshinImpact/Service/Agent/BetterGiAgentBackend.cs b/BetterGenshinImpact/Service/Agent/BetterGiAgentBackend.cs
new file mode 100644
index 0000000..b9ad977
--- /dev/null
+++ b/BetterGenshinImpact/Service/Agent/BetterGiAgentBackend.cs
@@ -0,0 +1,358 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Diagnostics;
+using System.Runtime.InteropServices;
+using System.IO;
+using System.Linq;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.RegularExpressions;
+using System.Threading;
+using System.Threading.Tasks;
+using BetterGenshinImpact.AgentBridge;
+using BetterGenshinImpact.Core.Recognition.OCR;
+using BetterGenshinImpact.Core.Script;
+using BetterGenshinImpact.GameTask;
+using BetterGenshinImpact.GameTask.AutoPathing;
+using BetterGenshinImpact.GameTask.AutoPathing.Model;
+using BetterGenshinImpact.GameTask.Common;
+using BetterGenshinImpact.GameTask.Common.BgiVision;
+using BetterGenshinImpact.GameTask.Common.Job;
+using BetterGenshinImpact.Core.Input;
+using BetterGenshinImpact.Helpers;
+using Newtonsoft.Json.Linq;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.Service.Agent;
+
+/// <summary>Development execution adapter. Daily success remains externally verified.</summary>
+internal sealed class BetterGiAgentBackend : IAgentGameBackend
+{
+    private readonly JObject _binding;
+    private readonly Dictionary<string, byte[]> _resources = new(StringComparer.Ordinal);
+    private readonly SemaphoreSlim _captureGate = new(1, 1);
+    private int _ownsTask;
+    private readonly AgentDailyJournal _daily;
+    private readonly AgentResinSession? _resin;
+    private readonly AgentVideoRecorder? _video;
+    private readonly AgentProgressSamples _progress = new();
+    private readonly Stopwatch _progressClock = Stopwatch.StartNew();
+    internal JArray Options { get; }
+    internal JObject Metadata { get; }
+    internal event Action? ManualStop;
+
+    internal BetterGiAgentBackend(string configurationPath)
+    {
+        var configuration = JObject.Parse(File.ReadAllText(configurationPath));
+        _binding = (JObject)(configuration["binding"]?.DeepClone()
+                            ?? throw new InvalidDataException("Agent account binding is required."));
+        if (!Regex.IsMatch(_binding.Value<string>("account_id") ?? "", "^[0-9]{8,10}$")
+            || string.IsNullOrWhiteSpace(_binding.Value<string>("server_id"))
+            || _binding["server_utc_offset_minutes"]?.Type != JTokenType.Integer
+            || _binding.Value<int>("server_utc_offset_minutes") is < -720 or > 840)
+            throw new InvalidDataException("Invalid agent account/server binding.");
+        var packPath = configuration.Value<string>("pack_directory")
+                       ?? throw new InvalidDataException("Agent task pack directory is required.");
+        var root = Path.GetFullPath(Path.IsPathRooted(packPath) ? packPath
+            : Path.Combine(Path.GetDirectoryName(Path.GetFullPath(configurationPath))!, packPath));
+        if ((File.GetAttributes(root) & FileAttributes.ReparsePoint) != 0)
+            throw new InvalidDataException("Agent task pack cannot be a linked directory.");
+        var manifestRaw = File.ReadAllBytes(Path.Combine(root, "manifest.json"));
+        var manifest = JObject.Parse(Encoding.UTF8.GetString(manifestRaw));
+        if (manifest.Value<int>("schema_version") != 2 || manifest.Value<string>("game_id") != "genshin"
+            || manifest.Value<string>("environment") != "windows"
+            || manifest.Value<string>("release_status") != "development"
+            || string.IsNullOrWhiteSpace(manifest.Value<string>("decision_model")))
+            throw new InvalidDataException("Only an explicit Windows development task pack is supported.");
+        var totalBytes = 0L;
+        foreach (var property in ((JObject)(manifest["files"] ?? throw new InvalidDataException("Missing pack resources."))).Properties())
+        {
+            var name = property.Name;
+            if (name.Split('/').Any(part => string.IsNullOrEmpty(part) || part is "." or "..")
+                || name.Contains('\\') || name.Contains(':') || Path.IsPathRooted(name))
+                throw new InvalidDataException("Invalid agent resource path.");
+            var path = Path.GetFullPath(Path.Combine(root, name));
+            if (!path.StartsWith(root + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase))
+                throw new InvalidDataException("Agent resource escapes its pack.");
+            for (var cursor = path; !string.Equals(cursor, root, StringComparison.OrdinalIgnoreCase); cursor = Path.GetDirectoryName(cursor)!)
+                if ((File.GetAttributes(cursor) & FileAttributes.ReparsePoint) != 0)
+                    throw new InvalidDataException("Agent resources cannot contain links.");
+            var size = new FileInfo(path).Length;
+            totalBytes += size;
+            if (size > 32 * 1024 * 1024 || totalBytes > 64 * 1024 * 1024)
+                throw new InvalidDataException("Agent resources exceed the size budget.");
+            var bytes = File.ReadAllBytes(path);
+            if (!string.Equals(Convert.ToHexString(SHA256.HashData(bytes)), property.Value.Value<string>(), StringComparison.OrdinalIgnoreCase))
+                throw new InvalidDataException("Agent task pack resource hash mismatch.");
+            _resources.Add(name, bytes);
+        }
+        var routePolicy = configuration["timed_route_policy"] as JObject;
+        if (routePolicy != null && (routePolicy.Count != 1
+            || routePolicy["skip_optional_fights_below_seconds"]?.Type != JTokenType.Integer))
+            throw new InvalidDataException("Invalid bounded timed route policy.");
+        if (configuration["timed_route_policy"] != null && routePolicy == null)
+            throw new InvalidDataException("Timed route policy must be an object.");
+        var routeThreshold = AgentTimedRoutePolicy.Validate(
+            routePolicy?.Value<int>("skip_optional_fights_below_seconds") ?? 0);
+        var memory = new AgentGoalMemory(Path.Combine(Path.GetDirectoryName(Path.GetFullPath(configurationPath))!, "goal-memory"),
+            configuration.Value<string>("goal_version") ?? "", Path.GetFileName(Path.GetDirectoryName(root)!));
+        _daily = new AgentDailyJournal(_resources, memory, routeThreshold);
+        if (configuration["resin_plan"] is JObject resinPlan)
+        {
+            if (configuration.Value<bool?>("record_video") != true) throw new InvalidDataException("Resin requires video.");
+            _resin = new AgentResinSession(Path.GetDirectoryName(Path.GetFullPath(configurationPath))!,
+                Path.GetDirectoryName(root)!, configuration.Value<string>("goal_version")!, resinPlan,
+                configuration.Value<string>("run_mode") == "development");
+        }
+        if (configuration.Value<bool?>("record_video") == true)
+        {
+            // Derive from the pinned pack's run directory; no arbitrary output target.
+            _video = new AgentVideoRecorder(Path.Combine(Path.GetDirectoryName(root)!, "video"), () =>
+            {
+                if (!SystemControl.IsGenshinImpactActiveByProcess())
+                    throw new AgentRecordingForegroundLostException();
+                using var region = TaskControl.CaptureToRectArea();
+                return region.SrcMat.Clone();
+            });
+            _video.Failed += () => ManualStop?.Invoke();
+        }
+        Options = JArray.Parse(Encoding.UTF8.GetString(_resources["actions.json"]));
+        foreach (var option in Options.Cast<JObject>())
+        {
+            var skill = option.Value<string>("skill");
+            if (_resin != null ? skill is not ("resin.scan" or "resin.domain")
+                : skill is not ("observe.capture" or "path.run" or "dialogue.select" or "daily.scan" or "daily.execute" or "daily.claim"))
+                throw new InvalidDataException("Agent task pack references an unsupported native skill.");
+            if (skill != "observe.capture" && (option["preconditions"]?["account_verified"]?.Type != JTokenType.Boolean
+                || option["preconditions"]?.Value<bool>("account_verified") != true
+                || option["preconditions"]?.Value<bool>("foreground") != true))
+                throw new InvalidDataException("Input skills must guard the account and foreground window.");
+        }
+        if (_resin == null) foreach (var option in AgentRecoveryActions.Catalog()) Options.Add(option);
+        Metadata = new JObject
+        {
+            ["protocol_version"] = 1, ["manifest_file_sha256"] = Convert.ToHexString(SHA256.HashData(manifestRaw)).ToLowerInvariant(),
+            ["decision_model"] = manifest["decision_model"]!.DeepClone(),
+            ["environment"] = "windows", ["release_status"] = "development",
+            ["timed_route_policy"] = new JObject { ["skip_optional_fights_below_seconds"] = routeThreshold },
+            ["game_video_v1"] = _video != null, ["resin_v1"] = _resin != null,
+            ["resin_plan"] = configuration["resin_plan"]?.DeepClone(),
+            ["daily_goal_control_v1"] = true, ["daily_recovery_v1"] = true,
+            ["recovery_catalog"] = AgentRecoveryActions.Catalog()
+        };
+    }
+
+    public async Task<GameObservation> CaptureAsync(CancellationToken cancellationToken)
+    {
+        if (!TaskContext.Instance().IsInitialized)
+        {
+            var runtime = App.GetService<BetterGenshinImpact.GameTask.Runtime.GameRuntimeService>()
+                ?? throw new InvalidOperationException("Game runtime service is unavailable.");
+            if (!await runtime.StartAsync(cancellationToken).ConfigureAwait(false))
+                throw new InvalidOperationException("Could not initialize the game capture service.");
+        }
+        await _captureGate.WaitAsync(cancellationToken).ConfigureAwait(false);
+        try
+        {
+            if (SystemControl.IsGenshinImpactActiveByProcess()) _video?.Start();
+            return await Task.Run(() =>
+            {
+                cancellationToken.ThrowIfCancellationRequested();
+                if (!TaskContext.Instance().IsInitialized) throw new InvalidOperationException("Start the BetterGI capture service first.");
+                using var region = TaskControl.CaptureToRectArea();
+                var scene = Bv.WhichGameUi(region) switch
+                {
+                    GameUiCategory.Main => "world", GameUiCategory.Talk => "dialogue",
+                    GameUiCategory.BigMap => "map", _ => "unknown"
+                };
+                var text = OcrFactory.Paddle.Ocr(region.SrcMat);
+                if (AgentRecoveryUi.IsColdDefeat(text)) scene = "cold_defeat";
+                var width = region.SrcMat.Width;
+                var height = region.SrcMat.Height;
+                var uidWidth = Math.Min(width, 384);
+                var uidHeight = Math.Min(height, 80);
+                using var uidRegion = region.SrcMat.SubMat(new Rect(width - uidWidth, height - uidHeight, uidWidth, uidHeight));
+                var uidText = OcrFactory.Paddle.Ocr(uidRegion);
+                var uid = AgentUidRecognition.Read(uidText, text);
+                var accountVerified = uid.AccountId != null && uid.AccountId == _binding.Value<string>("account_id");
+                var serverTime = DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromMinutes(_binding.Value<int>("server_utc_offset_minutes")));
+                var scope = new JObject
+                {
+                    ["account_id"] = uid.AccountId ?? _binding.Value<string>("account_id"),
+                    ["server_id"] = _binding.Value<string>("server_id"),
+                    ["game_day"] = serverTime.AddHours(-4).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
+                };
+                var facts = new JObject
+                {
+                    ["scene"] = scene, ["ocr_text"] = text, ["account_verified"] = accountVerified,
+                    ["uid_source"] = uid.Source,
+                    ["foreground"] = SystemControl.IsGenshinImpactActiveByProcess(),
+                    ["region"] = _binding.Value<string>("region"), ["region_source"] = "configured_task_region"
+                };
+                var daily = _daily.Snapshot();
+                if (_resin == null) facts.Merge(daily.Facts);
+                else facts.Merge(_resin.Snapshot());
+                var grounded = scene == "world" && Bv.GetMotionStatus(region) == MotionStatus.Normal;
+                facts["daily_recovery_v1"] = _resin == null;
+                facts["daily_recovery_grounded"] = grounded;
+                facts["player_low_hp"] = scene == "world" ? new JValue(Bv.CurrentAvatarIsLowHp(region)) : JValue.CreateNull();
+                facts["daily_review_interruptible"] = scene == "world" && _daily.ReviewInterruptible
+                    && grounded;
+                using (var crop = region.SrcMat.SubMat(new Rect(width / 5, height / 6, width * 3 / 5, height * 3 / 5)))
+                using (var small = new Mat())
+                using (var gray = new Mat())
+                {
+                    Cv2.Resize(crop, small, new Size(32, 18));
+                    Cv2.CvtColor(small, gray, ColorConversionCodes.BGR2GRAY);
+                    var pixels = new byte[32 * 18]; Marshal.Copy(gray.Data, pixels, 0, pixels.Length);
+                    var phaseKey = $"{daily.Facts["daily_goal"]?["active_quest_id"]}:{daily.Facts["daily_goal"]?["phase_revision"]}:{scene}";
+                    facts["execution_progress"] = _progress.Observe(phaseKey, _progressClock.ElapsedMilliseconds, pixels);
+                }
+                Cv2.ImEncode(".png", region.SrcMat, out var png);
+                cancellationToken.ThrowIfCancellationRequested();
+                return new GameObservation(scope, facts, new[] { "data:image/png;base64," + Convert.ToBase64String(png) }.Concat(daily.Images).Distinct().ToArray());
+            }, cancellationToken).ConfigureAwait(false);
+        }
+        finally { _captureGate.Release(); }
+    }
+
+    public async Task<SkillOutcome> ExecuteAsync(JObject option, CancellationToken cancellationToken)
+    {
+        if (option.Value<string>("skill") == "observe.capture")
+        {
+            var state = await CaptureAsync(cancellationToken).ConfigureAwait(false);
+            return new SkillOutcome("succeeded", "observation_captured", new JObject { ["facts"] = state.Facts });
+        }
+        if (!await TaskControl.TaskSemaphore.WaitAsync(0, cancellationToken).ConfigureAwait(false))
+            return new SkillOutcome("failed", "another_bettergi_task_owns_input", new JObject());
+        Interlocked.Exchange(ref _ownsTask, 1);
+        var runner = new TaskRunner();
+        var cancellationInitialized = false;
+        try
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+            runner.Init();
+            CancellationContext.Instance.Set();
+            cancellationInitialized = true;
+            RunnerContext.Instance.Clear();
+            using var linked = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken, CancellationContext.Instance.Cts.Token);
+            using var manualStop = CancellationContext.Instance.Cts.Token.Register(() =>
+            {
+                if (CancellationContext.Instance.IsManualStop) ManualStop?.Invoke();
+            });
+            var token = linked.Token;
+            token.ThrowIfCancellationRequested();
+            using var focusLease = CancellationTokenSource.CreateLinkedTokenSource(token);
+            var focusMonitor = MonitorForegroundAsync(focusLease.Token);
+            try
+            {
+                var arguments = option["arguments"] as JObject ?? new JObject();
+                if (_resin != null)
+                {
+                    var current = await CaptureAsync(token).ConfigureAwait(false);
+                    if (current.Facts.Value<bool?>("account_verified") != true) throw new InvalidOperationException("Account not verified.");
+                    await _resin.Execute(option.Value<string>("skill")!, current.Scope, token).ConfigureAwait(false);
+                    return new SkillOutcome("succeeded", "resin_operation_verified", new JObject { ["after_facts"] = _resin.Snapshot() });
+                }
+                if ((option.Value<string>("skill") ?? "").StartsWith("daily.", StringComparison.Ordinal))
+                {
+                    var current = await CaptureAsync(token).ConfigureAwait(false);
+                    var receiptStop = false;
+                    try { await _daily.ExecuteAsync(option.Value<string>("skill")!, arguments, current.Scope, token).ConfigureAwait(false); }
+                    catch (Exception) when (option.Value<string>("skill") is "daily.execute" or "daily.recover"
+                        && _daily.CommissionRewardReceived && !cancellationToken.IsCancellationRequested
+                        && !CancellationContext.Instance.IsManualStop)
+                    {
+                        receiptStop = true;
+                        InputHub.ReleaseAll();
+                    }
+                    // Outer user/lease cancellation still takes precedence over a receipt.
+                    cancellationToken.ThrowIfCancellationRequested();
+                    var afterDaily = await CaptureAsync(receiptStop ? cancellationToken : token).ConfigureAwait(false);
+                    return new SkillOutcome("succeeded", receiptStop ? "commission_primogems_received_requires_journal_evidence"
+                        : "daily_operation_finished_requires_journal_evidence",
+                        new JObject { ["after_facts"] = afterDaily.Facts });
+                }
+                if (option.Value<string>("skill") == "path.run")
+                {
+                    var resource = arguments.Value<string>("route") ?? "";
+                    if (!_resources.TryGetValue(resource, out var bytes)) throw new InvalidDataException("Route is outside the pinned task pack.");
+                    var task = AgentPinnedRoutes.ParseResource(bytes);
+                    var executor = new PathExecutor(token);
+                    token.ThrowIfCancellationRequested();
+                    await executor.Pathing(task).ConfigureAwait(false);
+                    token.ThrowIfCancellationRequested();
+                    if (!executor.SuccessEnd) return new SkillOutcome("failed", "path_executor_did_not_complete", new JObject());
+                }
+                else if (option.Value<string>("skill") == "dialogue.select")
+                {
+                    var text = arguments.Value<string>("text");
+                    if (string.IsNullOrWhiteSpace(text) || text.Length > 128) throw new InvalidDataException("Invalid dialogue text.");
+                    token.ThrowIfCancellationRequested();
+                    var result = await new ChooseTalkOptionTask().SingleSelectText(text, token, 3, true).ConfigureAwait(false);
+                    if (result != TalkOptionRes.FoundAndClick) return new SkillOutcome("failed", "dialogue_option_not_selected", new JObject());
+                }
+                else throw new InvalidDataException("Unsupported input skill.");
+
+                // Native execution and independent postcondition verification are separate.
+                await Task.Delay(150, token).ConfigureAwait(false);
+                var after = await CaptureAsync(token).ConfigureAwait(false);
+                var expectedText = arguments.Value<string>("verify_text");
+                var verified = !string.IsNullOrWhiteSpace(expectedText) && expectedText.Length <= 128
+                               && (after.Facts.Value<string>("ocr_text") ?? "").Contains(expectedText, StringComparison.Ordinal);
+                return new SkillOutcome(verified ? "succeeded" : "unknown",
+                    verified ? "visual_text_postcondition_observed" : "native_returned_postcondition_unverified",
+                    new JObject { ["execution_completed"] = true, ["visual_postcondition_verified"] = verified,
+                                  ["commission_completion_verified"] = false, ["daily_reward_verified"] = false,
+                                  ["after_facts"] = after.Facts });
+            }
+            finally
+            {
+                focusLease.Cancel();
+                await focusMonitor.ConfigureAwait(false);
+            }
+        }
+        finally
+        {
+            try
+            {
+                runner.End();
+                if (cancellationInitialized) CancellationContext.Instance.Clear();
+                RunnerContext.Instance.Clear();
+            }
+            finally
+            {
+                ReleaseInputs();
+                Interlocked.Exchange(ref _ownsTask, 0);
+                TaskControl.TaskSemaphore.Release();
+            }
+        }
+    }
+
+    public void ReleaseInputs()
+    {
+        // Do not release keys owned by an unrelated BetterGI task after a busy rejection.
+        if (Volatile.Read(ref _ownsTask) != 0) InputHub.ReleaseAll();
+    }
+
+    internal async ValueTask StopRecordingAsync()
+    {
+        if (_video != null) await _video.DisposeAsync().ConfigureAwait(false);
+    }
+
+    private async Task MonitorForegroundAsync(CancellationToken cancellationToken)
+    {
+        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
+        try
+        {
+            while (await timer.WaitForNextTickAsync(cancellationToken).ConfigureAwait(false))
+            {
+                if (SystemControl.IsGenshinImpactActiveByProcess()) continue;
+                ManualStop?.Invoke();
+                return;
+            }
+        }
+        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
+    }
+}
