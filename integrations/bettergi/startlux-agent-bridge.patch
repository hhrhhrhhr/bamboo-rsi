diff --git a/BetterGenshinImpact/Service/Agent/AgentRecoveryUi.cs b/BetterGenshinImpact/Service/Agent/AgentRecoveryUi.cs
new file mode 100644
index 0000000..6bf8be3
--- /dev/null
+++ b/BetterGenshinImpact/Service/Agent/AgentRecoveryUi.cs
@@ -0,0 +1,18 @@
+using System;
+using System.Text.RegularExpressions;
+
+namespace BetterGenshinImpact.Service.Agent;
+
+internal static class AgentRecoveryUi
+{
+    // The observed free respawn screen, not a food-selection revive dialog.
+    internal static bool IsColdDefeat(string text)
+    {
+        var compact = Regex.Replace(text, @"\s+", "");
+        return compact.Contains("复苏", StringComparison.Ordinal)
+            && compact.Contains("严寒", StringComparison.Ordinal)
+            && (compact.Contains("寒冷环境", StringComparison.Ordinal)
+                || (compact.Contains("积累至上限", StringComparison.Ordinal)
+                    && compact.Contains("削减角色生命值", StringComparison.Ordinal)));
+    }
+}
diff --git a/BetterGenshinImpact/Service/Agent/AgentResinBudget.cs b/BetterGenshinImpact/Service/Agent/AgentResinBudget.cs
new file mode 100644
index 0000000..9b117e6
--- /dev/null
+++ b/BetterGenshinImpact/Service/Agent/AgentResinBudget.cs
@@ -0,0 +1,173 @@
+using System;
+using System.IO;
+using System.Linq;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.RegularExpressions;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+
+namespace BetterGenshinImpact.Service.Agent;
+
+// Trusted spending boundary, not editable by the RSI candidate. A crash or
+// ambiguous claim blocks further spending across restarts and target changes.
+public sealed class AgentResinBudget
+{
+    private readonly string _root;
+    private string? _path;
+    private JObject? _scope;
+    private readonly string? _version;
+    private readonly bool _developerRetry;
+    public JObject Plan { get; }
+    public AgentResinBudget(string root, JObject plan, string? version = null, bool developerRetry = false)
+    {
+        _version = version; _developerRetry = developerRetry;
+        Plan = (JObject)plan.DeepClone(); _root = Path.GetFullPath(root);
+        if (plan.Count != 6 || plan.Value<bool?>("enabled") != true
+            || plan.Value<string>("resource") != "original_only"
+            || !Regex.IsMatch(plan.Value<string>("domain") ?? "", @"^[\u4e00-\u9fff·]{1,64}$")
+            || !Regex.IsMatch(plan.Value<string>("stage") ?? "", @"^[\u4e00-\u9fffA-Za-z0-9Ⅰ-Ⅻ·]{1,64}$")
+            || plan["recommended_level"]?.Type != JTokenType.Integer || plan.Value<int>("recommended_level") is < 1 or > 100
+            || plan["daily_budget"]?.Type != JTokenType.Integer || plan.Value<int>("daily_budget") is < 20 or > 200
+            || plan.Value<int>("daily_budget") % 20 != 0)
+            throw new InvalidDataException("Invalid original-resin plan.");
+        Directory.CreateDirectory(_root); RejectLink(_root);
+    }
+    private static void RejectLink(string path)
+    {
+        if ((File.Exists(path) || Directory.Exists(path)) && (File.GetAttributes(path) & FileAttributes.ReparsePoint) != 0)
+            throw new InvalidDataException("Resin evidence cannot contain links.");
+    }
+    public void Bind(JObject scope)
+    {
+        if (_scope != null && !JToken.DeepEquals(_scope, scope)) throw new InvalidDataException("Resin scope changed.");
+        if (new[] { "account_id", "server_id", "game_day" }.Any(k => scope[k]?.Type != JTokenType.String))
+            throw new InvalidDataException("Incomplete resin scope.");
+        _scope = (JObject)scope.DeepClone();
+        _path = Path.Combine(_root, Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(scope.ToString(Formatting.None)))) + ".json");
+        Read();
+    }
+    private JObject Read()
+    {
+        if (_path == null) throw new InvalidOperationException("Resin scope not bound.");
+        RejectLink(_path);
+        if (!File.Exists(_path)) return new JObject { ["scope"] = _scope!.DeepClone(), ["attempts"] = new JArray() };
+        if (new FileInfo(_path).Length > 1024 * 1024) throw new InvalidDataException("Resin ledger too large.");
+        var data = JObject.Parse(File.ReadAllText(_path));
+        if (!JToken.DeepEquals(data["scope"], _scope) || data["attempts"] is not JArray rows || rows.Count > 20
+            || rows.Any(r => r.Value<int>("cost") is not (20 or 40)
+                || r.Value<string>("status") is not ("reserved" or "verified" or "failed" or "unknown")
+                || string.IsNullOrWhiteSpace(r.Value<string>("id")))
+            || rows.Select(r => r.Value<string>("id")).Distinct().Count() != rows.Count)
+            throw new InvalidDataException("Invalid resin ledger; preserve for review.");
+        return data;
+    }
+    private void Write(JObject data)
+    {
+        var temp = _path + "." + Guid.NewGuid().ToString("N") + ".tmp";
+        using (var file = new FileStream(temp, FileMode.CreateNew, FileAccess.Write, FileShare.None))
+        { file.Write(Encoding.UTF8.GetBytes(data.ToString(Formatting.Indented))); file.Flush(true); }
+        File.Move(temp, _path!, true);
+    }
+    private FileStream Lease()
+    {
+        var path = Path.Combine(_root, "budget.lock"); RejectLink(path);
+        return new FileStream(path, FileMode.OpenOrCreate, FileAccess.ReadWrite, FileShare.None);
+    }
+    public JArray Rows => (JArray)Read()["attempts"]!;
+    public int Spent => Rows.Where(r => r.Value<string>("status") == "verified").Sum(r => r.Value<int>("cost"));
+    private JObject? RetryGrant(JArray rows)
+    {
+        // Explicit human-requested development continuation, never an autonomous
+        // budget reset. All original failures and the shared spending cap remain.
+        if (!_developerRetry || _version == null || _path == null) return null;
+        var path = _path + ".retry.json"; RejectLink(path);
+        if (!File.Exists(path)) return null;
+        if (new FileInfo(path).Length > 16384) throw new InvalidDataException("Retry grant too large.");
+        var grant = JObject.Parse(File.ReadAllText(path));
+        var failed = rows.Where(r => r.Value<string>("status") == "failed").Select(r => r.Value<string>("id")!).OrderBy(x => x).ToArray();
+        if (grant.Value<string>("origin") != "explicit_operator_development_retry"
+            || grant.Value<string>("version") != _version || !JToken.DeepEquals(grant["scope"], _scope)
+            || !JToken.DeepEquals(grant["plan"], Plan)
+            || !Regex.IsMatch(grant.Value<string>("id") ?? "", "^[a-f0-9]{32}$")
+            || grant["max_rounds"]?.Type != JTokenType.Integer || grant.Value<int>("max_rounds") is < 1 or > 10
+            || grant["failed_attempt_ids"] is not JArray approved || approved.Any(x => x.Type != JTokenType.String)
+            || !approved.Values<string>().OrderBy(x => x).SequenceEqual(failed)
+            || !DateTimeOffset.TryParse(grant.Value<string>("expires_at"), out var expires) || expires <= DateTimeOffset.UtcNow
+            || rows.Any(r => r.Value<string>("status") is "reserved" or "unknown")
+            || rows.Count(r => r.Value<string>("developer_retry_grant") == grant.Value<string>("id")) >= grant.Value<int>("max_rounds"))
+            return null;
+        return grant;
+    }
+    public bool Blocked { get { var rows = Rows; return rows.Any(r => r.Value<string>("status") is "reserved" or "unknown")
+        // Exhausting a development retry after the last verified claim is not an
+        // incomplete goal. The spending cap still makes NextCost zero. Unknown
+        // claims keep blocking even when the verified cap has been reached.
+        || Spent < Plan.Value<int>("daily_budget")
+            && rows.Count(r => r.Value<string>("status") == "failed") >= 2 && RetryGrant(rows) == null; } }
+    public int NextCost(int balance)
+    {
+        if (Blocked || balance is < 0 or > 200) return 0;
+        var remaining = Math.Min(balance, Plan.Value<int>("daily_budget") - Spent);
+        return remaining >= 40 ? 40 : remaining >= 20 ? 20 : 0;
+    }
+    public string Reserve(int balance, string run, string version)
+    {
+        using var lease = Lease();
+        var cost = NextCost(balance);
+        if (cost == 0) throw new InvalidOperationException("Resin budget unavailable.");
+        var data = Read(); var rows = (JArray)data["attempts"]!;
+        var grant = rows.Count(r => r.Value<string>("status") == "failed") >= 2 ? RetryGrant(rows) : null;
+        if (grant != null && version != _version) throw new InvalidDataException("Retry version changed.");
+        var id = Guid.NewGuid().ToString("N");
+        rows.Add(new JObject { ["id"] = id, ["run"] = run, ["version"] = version,
+            ["domain"] = Plan["domain"], ["stage"] = Plan["stage"], ["recommended_level"] = Plan["recommended_level"],
+            ["scope"] = _scope!.DeepClone(), ["before"] = balance, ["cost"] = cost,
+            ["status"] = "reserved", ["at"] = DateTimeOffset.UtcNow,
+            ["developer_retry_grant"] = grant?["id"]?.DeepClone() });
+        Write(data); return id;
+    }
+    public void Finish(string id, string status, JObject evidence)
+    {
+        using var lease = Lease(); var data = Read();
+        var row = data["attempts"]!.Single(r => r.Value<string>("id") == id);
+        if (row.Value<string>("status") != "reserved" || status is not ("verified" or "failed" or "unknown"))
+            throw new InvalidOperationException("Resin attempt cannot be overwritten.");
+        var claimBefore = evidence.Value<int?>("claim_before") ?? row.Value<int>("before");
+        if (status == "verified" && (evidence.Value<int?>("after") == null
+            || (evidence["claim_before"] != null && evidence["claim_before"]!.Type != JTokenType.Integer)
+            || claimBefore < row.Value<int>("before") || claimBefore > 200
+            || claimBefore - evidence.Value<int>("after") != row.Value<int>("cost")
+            || evidence["proofs"] is not JObject proofs
+            || new[] { "before", "selection", "claim", "reward", "after" }.Any(key =>
+                proofs[key]?.Type != JTokenType.String || string.IsNullOrWhiteSpace(proofs.Value<string>(key)))))
+            throw new InvalidDataException("Resin deduction and reward evidence required.");
+        ((JObject)row).Merge(evidence); row["status"] = status; Write(data);
+    }
+    public static int ReadCost(string text)
+    {
+        if (!text.Contains("原粹树脂", StringComparison.Ordinal)) return 0;
+        var matches = Regex.Matches(text, @"(?<!\d)(20|40)(?!\d)");
+        return matches.Count == 1 ? int.Parse(matches[0].Value) : 0;
+    }
+    public static int? ReadBalanceText(string text)
+    {
+        var matches = Regex.Matches(text, @"(?<!\d)(\d{1,3})\s*/\s*200(?!\d)");
+        if (matches.Count != 1) return null;
+        var value = int.Parse(matches[0].Groups[1].Value);
+        return value <= 200 ? value : null;
+    }
+    public static bool StageMatches(string observed, string expected)
+    {
+        static string Normalize(string text) => Regex.Replace(text.Normalize(NormalizationForm.FormKC), @"[\s:：]", "");
+        var actual = Normalize(observed); var stage = Normalize(expected);
+        return actual == stage || new[] { "祝圣秘境", "炼武秘境", "精通秘境" }.Any(prefix => actual == prefix + stage);
+    }
+    public static bool SelectedStageMatches(string observed, string expected)
+    {
+        // OCR may also see the adjacent information icon as a separate Greek glyph.
+        // Match one complete title line, never a substring that confuses V with IV/VI.
+        var lines = observed.Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
+        return lines.Count(line => StageMatches(line, expected)) == 1;
+    }
+}
diff --git a/BetterGenshinImpact/Service/Agent/AgentResinSession.cs b/BetterGenshinImpact/Service/Agent/AgentResinSession.cs
new file mode 100644
index 0000000..f539326
--- /dev/null
+++ b/BetterGenshinImpact/Service/Agent/AgentResinSession.cs
@@ -0,0 +1,216 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Security.Cryptography;
+using System.Text.RegularExpressions;
+using System.Threading;
+using System.Threading.Tasks;
+using BetterGenshinImpact.Core.Config;
+using BetterGenshinImpact.Core.Input;
+using BetterGenshinImpact.Core.Recognition;
+using BetterGenshinImpact.Core.Recognition.OCR;
+using BetterGenshinImpact.GameTask;
+using BetterGenshinImpact.GameTask.AutoDomain;
+using BetterGenshinImpact.GameTask.AutoTrackPath;
+using BetterGenshinImpact.GameTask.Common;
+using BetterGenshinImpact.GameTask.Common.BgiVision;
+using BetterGenshinImpact.GameTask.Common.Job;
+using BetterGenshinImpact.GameTask.Common.Element.Assets;
+using BetterGenshinImpact.GameTask.Model.Area;
+using Newtonsoft.Json.Linq;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.Service.Agent;
+
+public sealed class AgentResinSession
+{
+    private readonly AgentResinBudget _budget;
+    private readonly string _run;
+    private readonly string _version;
+    private int? _balance;
+    private JObject? _scope;
+    private string? _before;
+    private int _cost;
+    private int? _claimBalance;
+    private bool _claimClicked;
+    private bool _rewardSeen;
+    private string _phase = "preflight";
+    private JObject _proofs = new();
+    private readonly object _gate = new();
+    private JObject _facts = new() { ["resin_workload"] = true, ["resin_needs_scan"] = true, ["resin_can_run"] = false };
+    public AgentResinSession(string home, string run, string version, JObject plan, bool developerRetry = false)
+    {
+        _run = run; _version = version;
+        _budget = new AgentResinBudget(Path.Combine(home, "resin-budget"), plan, version, developerRetry);
+        if (!MapLazyAssets.Get().DomainPositionMap.ContainsKey(plan.Value<string>("domain")!))
+            throw new InvalidDataException("Domain is absent from pinned BetterGI map.");
+        Directory.CreateDirectory(Path.Combine(run, "resin-evidence"));
+        _facts["resin"] = new JObject { ["plan"] = _budget.Plan.DeepClone(), ["balance"] = null,
+            ["spent_today"] = null, ["done"] = false, ["blocked"] = false, ["receipts"] = new JArray() };
+    }
+    public JObject Snapshot() { lock (_gate) return (JObject)_facts.DeepClone(); }
+    private void Publish(bool needsScan = false)
+    {
+        lock (_gate) _facts = new JObject {
+            ["resin_workload"] = true, ["resin_needs_scan"] = needsScan,
+            ["resin_can_run"] = !needsScan && _balance != null && _budget.NextCost(_balance.Value) > 0,
+            ["resin"] = new JObject { ["plan"] = _budget.Plan.DeepClone(), ["balance"] = _balance,
+                ["spent_today"] = _budget.Spent, ["blocked"] = _budget.Blocked,
+                ["done"] = !needsScan && !_budget.Blocked && _balance != null && _budget.NextCost(_balance.Value) == 0,
+                ["receipts"] = new JArray(_budget.Rows.Where(r => r.Value<string>("run") == Path.GetFileName(_run)
+                    && r.Value<string>("status") == "verified")),
+                ["attempts"] = _budget.Rows } };
+    }
+    private string Save(ImageRegion frame)
+    {
+        Cv2.ImEncode(".png", frame.SrcMat, out var png);
+        var hash = Convert.ToHexString(SHA256.HashData(png)).ToLowerInvariant();
+        File.WriteAllBytes(Path.Combine(_run, "resin-evidence", hash + ".png"), png); return hash;
+    }
+    private async Task<(int Balance, string Proof)> ReadBalance(CancellationToken ct)
+    {
+        await new ReturnMainUiTask().Start(ct);
+        await new TpTask(ct).OpenBigMapUi();
+        int? previous = null;
+        for (var i = 0; i < 8; i++)
+        {
+            await Task.Delay(400, ct);
+            using var frame = TaskControl.CaptureToRectArea();
+            // The upstream thresholded crop truncates digits with some UI layouts.
+            // Require the map and a unique literal current/200 in its resin-only top bar.
+            using var top = frame.DeriveCrop(new Rect((int)(frame.Width * .62), 0,
+                (int)(frame.Width * .13), (int)(frame.Height * .08)));
+            var value = Bv.WhichGameUi(frame) == GameUiCategory.BigMap
+                ? AgentResinBudget.ReadBalanceText(OcrFactory.Paddle.Ocr(top.SrcMat)) : null;
+            if (value != null)
+            {
+                if (previous == value.Value)
+                {
+                    var result = (value.Value, Save(frame));
+                    await new ReturnMainUiTask().Start(ct); return result;
+                }
+                previous = value.Value;
+            }
+            else previous = null;
+        }
+        throw new InvalidDataException("Two stable original-resin readings required.");
+    }
+    public async Task Execute(string skill, JObject scope, CancellationToken ct)
+    {
+        _budget.Bind(scope); _scope = (JObject)scope.DeepClone();
+        if (skill == "resin.scan")
+        {
+            var reading = await ReadBalance(ct); _balance = reading.Balance; _before = reading.Proof;
+            Publish(); return;
+        }
+        if (skill != "resin.domain" || _balance == null) throw new InvalidOperationException("Scan resin first.");
+        // Read immediately before reservation; the model's previous frame is not a balance oracle.
+        var before = await ReadBalance(ct); _balance = before.Balance; _before = before.Proof;
+        _cost = _budget.NextCost(_balance.Value);
+        var id = _budget.Reserve(_balance.Value, Path.GetFileName(_run), _version);
+        _claimClicked = _rewardSeen = false; _claimBalance = null; _proofs = new JObject { ["before"] = _before };
+        Publish();
+        try
+        {
+            var path = Global.Absolute(@"User\AutoFight\StartLux\bennett-ayaka-yelan-zhongli.txt");
+            if (!File.Exists(path)) throw new FileNotFoundException("Frozen combat strategy missing.");
+            var param = new AutoDomainParam(1, path) {
+                DomainName = _budget.Plan.Value<string>("domain")!, PartyName = "", SundaySelectedValue = "",
+                AutoArtifactSalvage = false, SpecifyResinUse = true, ResinPriorityList = new List<string> { "原粹树脂" },
+                OriginalResinUseCount = 0, OriginalResin20UseCount = _cost == 20 ? 1 : 0,
+                OriginalResin40UseCount = _cost == 40 ? 1 : 0, CondensedResinUseCount = 0,
+                TransientResinUseCount = 0, FragileResinUseCount = 0, RewardRecognitionEnabled = false,
+                AgentResin = this };
+            _phase = "travel_or_entry";
+            await new AutoDomainTask(param).Start(ct);
+            if (!_claimClicked || !_rewardSeen) throw new InvalidDataException("Domain returned without a verified claim.");
+            _phase = "balance_verification";
+            var after = await ReadBalance(ct); _balance = after.Balance; _proofs["after"] = after.Proof;
+            _phase = "ledger_verification";
+            _budget.Finish(id, "verified", new JObject { ["after"] = _balance,
+                ["claim_before"] = _claimBalance, ["proofs"] = _proofs });
+        }
+        catch (Exception error)
+        {
+            _budget.Finish(id, _claimClicked ? "unknown" : "failed", new JObject {
+                ["proofs"] = _proofs, ["after"] = _proofs["after"] != null ? _balance : null,
+                ["claim_before"] = _claimBalance,
+                ["failure_phase"] = _phase, ["error_type"] = error.GetType().Name });
+            Publish(true); throw;
+        }
+        Publish();
+    }
+    // Map names and challenge names differ. Bind the row's title AND level,
+    // select that row, then require the right-hand title to confirm selection.
+    public async Task SelectAndVerify(CancellationToken ct)
+    {
+        _phase = "entry_selection";
+        using var frame = TaskControl.CaptureToRectArea();
+        var level = _budget.Plan.Value<int>("recommended_level");
+        var stage = _budget.Plan.Value<string>("stage")!;
+        _proofs["entry_menu"] = Save(frame);
+        var rows = frame.FindMulti(RecognitionObject.Ocr(0, frame.Height * .10, frame.Width * .48, frame.Height * .70));
+        var titles = rows.Where(r => AgentResinBudget.StageMatches(r.Text, stage)).ToArray();
+        if (titles.Length != 1 || !rows.Any(r => r.Y > titles[0].Y && r.Y < titles[0].Y + frame.Height * .08
+            && Regex.IsMatch(Regex.Replace(r.Text, @"\s+", ""), $@"推荐(?:队伍)?等级[:：]?{level}(?!\d)")))
+            throw new InvalidDataException("Configured domain/difficulty not visually verified; no challenge entered.");
+        ct.ThrowIfCancellationRequested(); titles[0].Click();
+        await Task.Delay(500, ct);
+        using var selected = TaskControl.CaptureToRectArea();
+        using var heading = selected.DeriveCrop(new Rect((int)(selected.Width * .63), (int)(selected.Height * .10),
+            (int)(selected.Width * .35), (int)(selected.Height * .08)));
+        if (!AgentResinBudget.SelectedStageMatches(OcrFactory.Paddle.Ocr(heading.SrcMat), stage)
+            || !OcrFactory.Paddle.Ocr(selected.SrcMat).Contains("单人挑战", StringComparison.Ordinal))
+            throw new InvalidDataException("Selected challenge title not confirmed.");
+        _proofs["selection"] = Save(selected);
+        _phase = "challenge";
+    }
+    public async Task<bool> Claim(CancellationToken ct)
+    {
+        _phase = "claim_validation";
+        InputHub.ReleaseAll();
+        for (var attempt = 0; attempt < 12; attempt++)
+        {
+            await Task.Delay(500, ct);
+            using var frame = TaskControl.CaptureToRectArea();
+            var rows = frame.FindMulti(RecognitionObject.Ocr(frame.Width * .25, frame.Height * .2, frame.Width * .5, frame.Height * .6));
+            var text = string.Join(" ", rows.Select(r => r.Text));
+            if (text.Contains("补充原粹树脂") || text.Contains("数量不足"))
+                throw new InvalidDataException("Original resin unavailable; refills are forbidden.");
+            var original = rows.Where(r => r.Text.Contains("原粹树脂", StringComparison.Ordinal)).ToArray();
+            if (original.Length != 1) continue;
+            var cost = AgentResinBudget.ReadCost(original[0].Text);
+            if (cost == 0) throw new InvalidDataException("Unambiguous original-resin cost is required before clicking.");
+            if (cost != _cost)
+            {
+                using var toggle = frame.Find(RecognitionAssets.Get("AutoDomain", "ResinSwitchBtn", frame.Width, frame.Height));
+                if (toggle.IsEmpty()) throw new InvalidDataException("Required original-resin amount unavailable.");
+                ct.ThrowIfCancellationRequested(); toggle.Click(); continue;
+            }
+            var buttons = rows.Where(r => r.Text.Trim() == "使用" && r.X > frame.Width / 2
+                && r.Y < original[0].Y + original[0].Height && original[0].Y < r.Y + r.Height).ToArray();
+            if (buttons.Length != 1) throw new InvalidDataException("Unique original-resin use button required.");
+            // Natural regeneration can occur during combat. Read the balance from
+            // this same original-resin claim frame, immediately before the click.
+            using var top = frame.DeriveCrop(new Rect((int)(frame.Width * .5), 0,
+                (int)(frame.Width * .45), (int)(frame.Height * .08)));
+            _claimBalance = AgentResinBudget.ReadBalanceText(OcrFactory.Paddle.Ocr(top.SrcMat));
+            if (_claimBalance == null || _claimBalance < _balance || _claimBalance < _cost)
+                throw new InvalidDataException("Fresh original-resin balance required before claiming.");
+            _proofs["claim"] = Save(frame);
+            ct.ThrowIfCancellationRequested(); _claimClicked = true; _phase = "reward_verification"; buttons[0].Click(); break;
+        }
+        if (!_claimClicked) throw new InvalidDataException("No verified original-resin claim dialog.");
+        for (var attempt = 0; attempt < 20; attempt++)
+        {
+            await Task.Delay(500, ct); using var frame = TaskControl.CaptureToRectArea();
+            using var exit = frame.Find(RecognitionAssets.Get("AutoFight", "Exit", frame));
+            using var repeat = frame.Find(RecognitionAssets.Get("AutoFight", "Confirm", frame));
+            if (exit.IsEmpty() || repeat.IsEmpty()) continue;
+            _proofs["reward"] = Save(frame); _rewardSeen = true;
+            ct.ThrowIfCancellationRequested(); exit.Click(); return false;
+        }
+        throw new InvalidDataException("Claim outcome unknown; spending blocked pending review.");
+    }
+}
diff --git a/BetterGenshinImpact/Service/Agent/AgentScriptInput.cs b/BetterGenshinImpact/Service/Agent/AgentScriptInput.cs
new file mode 100644
index 0000000..2b2403a
--- /dev/null
+++ b/BetterGenshinImpact/Service/Agent/AgentScriptInput.cs
@@ -0,0 +1,46 @@
+using System;
+
+namespace BetterGenshinImpact.Service.Agent;
+
+/// <summary>Per-command interaction timing and dialogue-entry evidence.</summary>
+internal sealed class AgentScriptInput(
+    Action<string> press, Action<string> down, Action<string> up,
+    Action<int> wait, Func<bool> isDialogue, bool requireDialogue)
+{
+    private bool _interactionAttempted;
+    private bool _dialogueObserved;
+
+    internal void Press(string key)
+    {
+        ObserveDialogue();
+        if (!key.Equals("F", StringComparison.OrdinalIgnoreCase)
+            && !key.Equals("VK_F", StringComparison.OrdinalIgnoreCase))
+        {
+            press(key);
+            return;
+        }
+
+        _interactionAttempted = true;
+        // A down/up pair in one SendInput batch may be missed by a game frame.
+        // Always release even if cancellation arrives while the key is held.
+        down(key);
+        try { wait(100); }
+        finally { up(key); }
+        wait(400);
+        ObserveDialogue();
+    }
+
+    private void ObserveDialogue()
+    {
+        if (requireDialogue && !_dialogueObserved && isDialogue())
+            _dialogueObserved = true;
+    }
+
+    internal void VerifyDialogue()
+    {
+        ObserveDialogue();
+        if (requireDialogue && _interactionAttempted && !_dialogueObserved)
+            throw new InvalidOperationException(
+                "Talk commission attempted interaction but never entered a verified dialogue view.");
+    }
+}
diff --git a/BetterGenshinImpact/Service/Agent/AgentTimedRoutePolicy.cs b/BetterGenshinImpact/Service/Agent/AgentTimedRoutePolicy.cs
new file mode 100644
index 0000000..4a032db
--- /dev/null
+++ b/BetterGenshinImpact/Service/Agent/AgentTimedRoutePolicy.cs
@@ -0,0 +1,37 @@
+using System;
+using System.Text.RegularExpressions;
+
+namespace BetterGenshinImpact.Service.Agent;
+
+/// <summary>Bounded model-selected behavior for Full Speed Ahead only.</summary>
+internal static class AgentTimedRoutePolicy
+{
+    internal static int Validate(int threshold) => threshold == 0
+        ? threshold : throw new ArgumentOutOfRangeException(nameof(threshold));
+
+    internal static int? RemainingSeconds(string text)
+    {
+        var compact = Regex.Replace(text, @"\s+", "");
+        // A clock or ability cooldown alone cannot enable the route override.
+        if (!(compact.Contains("击败魔物", StringComparison.Ordinal)
+                || compact.Contains("消灭魔物", StringComparison.Ordinal))
+            || !compact.Contains("时间", StringComparison.Ordinal)
+            || !compact.Contains("中断挑战", StringComparison.Ordinal))
+            return null;
+        var labelled = Regex.Match(compact, @"剩余时间[:：](\d{1,3})秒");
+        int? seconds = labelled.Success ? int.Parse(labelled.Groups[1].Value) : null;
+        var clock = Regex.Match(text, @"(?<!\d)([0-2]):([0-5]\d)(?!\d)");
+        // Also accept the observed 00:29 form, retaining exact timer syntax.
+        if (!clock.Success) clock = Regex.Match(text, @"(?<!\d)(0[0-2]):([0-5]\d)(?!\d)");
+        if (clock.Success)
+        {
+            var clockSeconds = int.Parse(clock.Groups[1].Value) * 60 + int.Parse(clock.Groups[2].Value);
+            if (seconds.HasValue && Math.Abs(seconds.Value - clockSeconds) > 1) return null;
+            seconds ??= clockSeconds;
+        }
+        return seconds is > 0 and <= 180 ? seconds : null;
+    }
+
+    internal static bool SkipFight(int threshold, int? seconds)
+        => Validate(threshold) > 0 && seconds is > 0 && seconds <= threshold;
+}
