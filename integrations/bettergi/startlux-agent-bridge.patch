+using BetterGenshinImpact.Service.Agent;
+using Newtonsoft.Json.Linq;
+using Xunit;
+
+public class ResinBudgetTests
+{
+    private static JObject Plan(int budget = 200) => new() { ["enabled"] = true, ["domain"] = "铭记之谷",
+        ["recommended_level"] = 90, ["stage"] = "钢铁之舞V", ["daily_budget"] = budget, ["resource"] = "original_only" };
+    private static JObject Scope(string day = "2026-10-22") => new() { ["account_id"] = "fixture", ["server_id"] = "fixture", ["game_day"] = day };
+    private static AgentResinBudget Open(string root, int limit = 200)
+    { var budget = new AgentResinBudget(root, Plan(limit)); budget.Bind(Scope()); return budget; }
+    private static string Root() => Path.Combine(Path.GetTempPath(), "resin-unit-" + Guid.NewGuid().ToString("N"));
+    [Fact] public void InterruptedReservationBlocksRestartAndChangedTarget()
+    {
+        var root = Root(); var budget = Open(root);
+        budget.Reserve(200, "run", "version");
+        var restored = Open(root);
+        Assert.True(restored.Blocked); Assert.Equal(0, restored.NextCost(200));
+        Assert.Throws<InvalidOperationException>(() => restored.Reserve(200, "run2", "v2"));
+    }
+    [Fact] public void OnlyTwoFailuresAcrossVersionsAndRestarts()
+    {
+        var root = Root(); var budget = Open(root);
+        var first = budget.Reserve(200, "run", "v1"); budget.Finish(first, "failed", new JObject());
+        budget = Open(root); Assert.False(budget.Blocked);
+        var second = budget.Reserve(200, "run2", "v2"); budget.Finish(second, "failed", new JObject());
+        Assert.True(Open(root).Blocked);
+    }
+    [Fact] public void UnknownClaimCannotBeRetriedOrOverwritten()
+    {
+        var budget = Open(Root()); var id = budget.Reserve(200, "run", "v1");
+        budget.Finish(id, "unknown", new JObject()); Assert.True(budget.Blocked);
+        Assert.Throws<InvalidOperationException>(() => budget.Finish(id, "failed", new JObject()));
+    }
+    [Fact] public void DeductionMustMatchAndBudgetPersists()
+    {
+        var root = Root(); var budget = Open(root, 40); var id = budget.Reserve(60, "run", "v1");
+        var proofs = new JObject { ["before"] = "a", ["selection"] = "b", ["claim"] = "c", ["reward"] = "d", ["after"] = "e" };
+        Assert.Throws<InvalidDataException>(() => budget.Finish(id, "verified", new JObject { ["after"] = 21, ["proofs"] = proofs }));
+        budget.Finish(id, "verified", new JObject { ["after"] = 20, ["proofs"] = proofs });
+        var restored = Open(root, 40); Assert.Equal(40, restored.Spent); Assert.Equal(0, restored.NextCost(20));
+    }
+    [Theory] [InlineData("原粹树脂 ×20",20)] [InlineData("原粹树脂40",40)]
+    [InlineData("原粹树脂",0)] [InlineData("浓缩树脂20",0)] [InlineData("原粹树脂20/40",0)] [InlineData("原粹树脂200",0)]
+    public void NeverDefaultsUnknownOrWrongCurrencyToTwenty(string text, int cost) => Assert.Equal(cost, AgentResinBudget.ReadCost(text));
+    [Theory] [InlineData("extra",true)] [InlineData("missing",false)] [InlineData("wrong_names",false)]
+    [InlineData("empty",false)] [InlineData("non_string",false)]
+    public void RequireNamedRewardEvidenceAndAllowAdditionalDiagnostics(string mode, bool valid)
+    {
+        var b = Open(Root()); var id = b.Reserve(200,"run","v");
+        var p = new JObject { ["before"]="a", ["selection"]="b", ["claim"]="c", ["reward"]="d", ["after"]="e" };
+        if (mode == "extra") p["entry_menu"]="f";
+        if (mode == "missing") p.Remove("reward");
+        if (mode == "wrong_names") { p.Remove("reward"); p["entry_menu"]="f"; }
+        if (mode == "empty") p["reward"]="";
+        if (mode == "non_string") p["reward"]=true;
+        var evidence = new JObject { ["after"]=160, ["proofs"]=p };
+        if (valid) { b.Finish(id,"verified",evidence); Assert.Equal(40,b.Spent); }
+        else { Assert.Throws<InvalidDataException>(() => b.Finish(id,"verified",evidence)); Assert.True(b.Blocked); }
+    }
+    [Theory] [InlineData(82,42,true)] [InlineData(null,42,false)] [InlineData(82,43,false)]
+    [InlineData(80,40,false)] [InlineData(201,161,false)] [InlineData(81,41,true)]
+    public void RegenerationNeedsFreshClaimBalanceAndExactDeduction(int? claimBefore,int after,bool valid)
+    {
+        var b=Open(Root());var id=b.Reserve(81,"run","v");
+        var e=new JObject { ["after"]=after, ["proofs"]=new JObject {
+            ["before"]="a",["selection"]="b",["claim"]="c",["reward"]="d",["after"]="e" } };
+        if (claimBefore != null) e["claim_before"]=claimBefore;
+        if (valid) { b.Finish(id,"verified",e); Assert.Equal(40,b.Spent); }
+        else { Assert.Throws<InvalidDataException>(()=>b.Finish(id,"verified",e)); Assert.True(b.Blocked); }
+    }
+    [Theory] [InlineData("200/200",200)] [InlineData("0/200",0)] [InlineData("180 / 200",180)]
+    [InlineData("2001200",null)] [InlineData("201/200",null)] [InlineData("20/200 40/200",null)] [InlineData("remaining 20",null)]
+    public void BalanceRequiresOneLiteralFraction(string text, int? expected) => Assert.Equal(expected, AgentResinBudget.ReadBalanceText(text));
+    [Theory] [InlineData("祝圣秘境: 钢铁之舞 V",true)] [InlineData("祝圣秘境：钢铁之舞Ⅴ",true)]
+    [InlineData("铭记之谷",false)] [InlineData("祝圣秘境：钢铁之舞IV",false)] [InlineData("祝圣秘境：钢铁之舞VI",false)]
+    public void BindActualStageTitleInsteadOfMapName(string observed, bool expected) => Assert.Equal(expected, AgentResinBudget.StageMatches(observed,"钢铁之舞V"));
+    [Theory] [InlineData("祝圣秘境: 钢铁之舞 V\nθ",true)]
+    [InlineData("祝圣秘境: 钢铁之舞 IV\nθ",false)] [InlineData("祝圣秘境: 钢铁之舞 VI\nθ",false)]
+    [InlineData("θ",false)] [InlineData("祝圣秘境: 钢铁之舞 V θ",false)]
+    [InlineData("祝圣秘境: 钢铁之舞 V\n祝圣秘境: 钢铁之舞 V",false)]
+    public void IgnoreSeparateInformationIconButRequireOneExactSelectedTitle(string observed, bool expected)
+        => Assert.Equal(expected, AgentResinBudget.SelectedStageMatches(observed,"钢铁之舞V"));
+    [Fact] public void CorruptedHistoryFailsClosed()
+    {
+        var root = Root(); var budget = Open(root); budget.Reserve(20, "run", "v1");
+        File.WriteAllText(Directory.GetFiles(root,"*.json").Single(), "{}");
+        Assert.Throws<InvalidDataException>(() => Open(root));
+    }
+    [Theory]
+    [InlineData("valid",false)] [InlineData("autonomous",true)] [InlineData("wrong_version",true)]
+    [InlineData("wrong_plan",true)] [InlineData("expired",true)] [InlineData("unknown",true)]
+    [InlineData("new_failure",true)] [InlineData("used",true)]
+    public void ExplicitDevelopmentRetryPreservesFailuresAndCannotHideAnotherFailure(string mode, bool blocked)
+    {
+        var root = Root(); var old = Open(root);
+        var first = old.Reserve(200,"first","old"); old.Finish(first,"failed",new JObject());
+        var second = old.Reserve(200,"second","old"); old.Finish(second,"failed",new JObject());
+        var grantId = new string('a',32);
+        var grant = new JObject { ["id"] = grantId, ["origin"] = "explicit_operator_development_retry",
+            ["scope"] = Scope(), ["plan"] = Plan(), ["version"] = "new", ["max_rounds"] = 1,
+            ["failed_attempt_ids"] = new JArray(first,second), ["expires_at"] = DateTimeOffset.UtcNow.AddHours(1).ToString("O") };
+        if (mode == "wrong_version") grant["version"] = "different";
+        if (mode == "wrong_plan") grant["plan"]!["recommended_level"] = 80;
+        if (mode == "expired") grant["expires_at"] = DateTimeOffset.UtcNow.AddMinutes(-1).ToString("O");
+        File.WriteAllText(Directory.GetFiles(root,"*.json").Single()+".retry.json",grant.ToString());
+        var budget = new AgentResinBudget(root,Plan(),"new",mode != "autonomous"); budget.Bind(Scope());
+        if (mode is "unknown" or "new_failure" or "used")
+        {
+            var id = budget.Reserve(200,"retry","new");
+            Assert.True(budget.Blocked); // In-flight reservation is always protected.
+            budget.Finish(id, mode == "unknown" ? "unknown" : mode == "new_failure" ? "failed" : "verified",
+                mode == "used" ? new JObject { ["after"] = 160, ["proofs"] = new JObject {
+                    ["before"]="a",["selection"]="b",["claim"]="c",["reward"]="d",["after"]="e" } } : new JObject());
+        }
+        Assert.Equal(blocked,budget.Blocked);
+        Assert.Equal(2,budget.Rows.Count(r => r.Value<string>("id") == first || r.Value<string>("id") == second));
+        Assert.Equal(mode == "used" ? 40 : 0,budget.Spent);
+        Assert.True(Open(root).Blocked); // A grant never affects autonomous operation.
+    }
+    [Theory] [InlineData(false)] [InlineData(true)]
+    public void ReachedSpendingCapIsCompleteButUnknownClaimsStillBlock(bool unknown)
+    {
+        var root=Root();var b=Open(root,40);
+        var first=b.Reserve(200,"first","old");b.Finish(first,"failed",new JObject());
+        var second=b.Reserve(200,"second","old");b.Finish(second,"failed",new JObject());
+        var file=Directory.GetFiles(root,"*.json").Single();
+        var grant=new JObject { ["id"]=new string('a',32),["origin"]="explicit_operator_development_retry",
+            ["scope"]=Scope(),["plan"]=Plan(40),["version"]="new",["max_rounds"]=1,
+            ["failed_attempt_ids"]=new JArray(first,second),["expires_at"]=DateTimeOffset.UtcNow.AddHours(1).ToString("O") };
+        File.WriteAllText(file+".retry.json",grant.ToString());
+        b=new AgentResinBudget(root,Plan(40),"new",true);b.Bind(Scope());
+        var id=b.Reserve(200,"last","new");b.Finish(id,"verified",new JObject { ["after"]=160,
+            ["proofs"]=new JObject { ["before"]="a",["selection"]="b",["claim"]="c",["reward"]="d",["after"]="e" } });
+        if (unknown) {
+            var data=JObject.Parse(File.ReadAllText(file));
+            ((JArray)data["attempts"]!).Add(new JObject { ["id"]="ambiguous",["cost"]=20,["status"]="unknown" });
+            File.WriteAllText(file,data.ToString());
+        }
+        Assert.Equal(unknown,b.Blocked);Assert.Equal(0,b.NextCost(160));
+        Assert.Equal(unknown,Open(root,40).Blocked);Assert.Equal(40,b.Spent);
+    }
+}
