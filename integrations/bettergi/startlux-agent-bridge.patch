@@ -0,0 +1,85 @@
+using BetterGenshinImpact.Service.Agent;
+using Newtonsoft.Json.Linq;
+using Xunit;
+
+namespace BetterGenshinImpact.AgentBridge.Tests;
+
+public sealed class AgentGoalMemoryTests : IDisposable
+{
+    private readonly string _root = Path.Combine(Path.GetTempPath(), "goal-memory-test-" + Guid.NewGuid().ToString("N"));
+    private static JObject Scope(string day = "2026-10-22", string account = "test-account") => new()
+        { ["account_id"] = account, ["server_id"] = "test", ["game_day"] = day };
+    private AgentGoalMemory Open(string version = "a", string day = "2026-10-22", string account = "test-account")
+    {
+        var memory = new AgentGoalMemory(_root, new string(version[0], 64), Guid.NewGuid().ToString("N"));
+        memory.Bind(Scope(day, account));
+        memory.BindRoster(new[] { "one", "two", "three", "four" });
+        return memory;
+    }
+    private static JArray Rows(bool reordered = false) => new(Enumerable.Range(1, 4).Select(i => new JObject
+        { ["id"] = i, ["name"] = (reordered ? new[] { "two", "one", "three", "four" }
+            : new[] { "one", "two", "three", "four" })[i - 1], ["location"] = "fixture" }));
+    [Fact]
+    public void RestartAndChangedVersionCannotEraseReservations()
+    {
+        var first = Open(); first.Reserve("one", "fixture", "default"); // simulated crash, no outcome
+        var second = Open();
+        Assert.Equal(1, second.Used("one"));
+        Assert.False(second.CanUseDefault("one"));
+        Assert.Equal("reserved", second.History("one")[0]!.Value<string>("status"));
+        var nextVersion = Open("b");
+        Assert.True(nextVersion.CanUseDefault("one"));
+        var id = nextVersion.Reserve("one", "fixture", "default"); nextVersion.Verify(id, false);
+        Assert.Equal(2, Open("c").Used("one"));
+        Assert.Throws<InvalidOperationException>(() => Open("c").Reserve("one", "fixture", "heal_retry"));
+        Assert.Equal(0, Open(day: "2026-10-23").Used("one"));
+        Assert.Equal(0, Open(account: "another-account").Used("one"));
+    }
+    [Fact]
+    public void ReorderedSlotsKeepBudgetAndRestartDisallowsStaleLocationRecovery()
+    {
+        var memory = Open(); var first = new AgentGoalProgress(memory); first.BindRows(Rows());
+        first.Begin(1, "one"); first.Verify(false);
+        Assert.False(first.Available(1)); Assert.True(first.LocalRecovery(1));
+        var restarted = new AgentGoalProgress(Open()); restarted.BindRows(Rows(true));
+        Assert.False(restarted.Available(2)); Assert.True(restarted.Available(1));
+        Assert.True(restarted.CanRetry(2)); Assert.False(restarted.LocalRecovery(2));
+        Assert.Throws<InvalidOperationException>(() => restarted.Begin(2, "one", "ranged"));
+        restarted.Begin(2, "one", "heal_retry"); restarted.Verify(false);
+        Assert.False(restarted.CanRetry(2));
+        Assert.Equal(2, restarted.Snapshot()["failed_attempts_by_slot"]!.Value<int>("2"));
+    }
+    [Fact]
+    public void CompletingRecoveryRequiresJournalVerificationAndDoesNotAddExtraBudget()
+    {
+        var memory = Open(); var goal = new AgentGoalProgress(memory); goal.BindRows(Rows());
+        goal.Begin(1, "one"); goal.Verify(false); goal.Begin(1, "one", "reposition_left");
+        Assert.Equal("reserved", memory.History("one")[1]!.Value<string>("status"));
+        Assert.False(goal.LocalRecovery(1));
+        goal.Verify(true);
+        Assert.Equal("completed", memory.History("one")[1]!.Value<string>("status"));
+        Assert.True(goal.Snapshot()["last_verification"]!.Value<bool>("completed"));
+        Assert.False(goal.Available(1)); Assert.False(goal.CanRetry(1));
+        goal.Verify(false); // scanning again cannot turn success into failure
+        Assert.Equal("completed", memory.History("one")[1]!.Value<string>("status"));
+    }
+    [Fact]
+    public void ChangedRosterAndCorruptMemoryFailClosedWithoutOverwritingEvidence()
+    {
+        var memory = Open(); memory.Reserve("one", "fixture", "default");
+        Assert.Throws<InvalidDataException>(() => memory.BindRoster(new[] { "renamed", "two", "three", "four" }));
+        Assert.Throws<InvalidOperationException>(() => memory.Bind(Scope("2026-10-23")));
+        var file = Directory.GetFiles(_root, "*.json").Single(); File.WriteAllText(file, "{broken-evidence");
+        Assert.ThrowsAny<Exception>(() => Open());
+        Assert.Equal("{broken-evidence", File.ReadAllText(file));
+    }
+    [Fact]
+    public void OtherQuestClearsLocalRecoveryButDoesNotEraseItsFailure()
+    {
+        var goal = new AgentGoalProgress(Open()); goal.BindRows(Rows());
+        goal.Begin(1, "one"); goal.Verify(false); goal.Begin(2, "two"); goal.Verify(true);
+        Assert.False(goal.LocalRecovery(1)); Assert.True(goal.CanRetry(1));
+        Assert.Equal(1, goal.Snapshot()["failed_attempts_by_slot"]!.Value<int>("1"));
+    }
+    public void Dispose() { if (Directory.Exists(_root)) Directory.Delete(_root, true); }
+}
