+    {
+        var events = new List<string>();
+        var input = new AgentScriptInput(k => events.Add("press"), k => events.Add("down"),
+            k => events.Add("up"), _ => throw new OperationCanceledException(), () => false, true);
+        Assert.Throws<OperationCanceledException>(() => input.Press("F"));
+        Assert.Equal(new[] { "down", "up" }, events);
+    }
+
+    [Fact]
+    public void WorldViewThroughoutDoesNotCountAsFinishedDialogue()
+    {
+        var input = new AgentScriptInput(_ => { }, _ => { }, _ => { }, _ => { }, () => false, true);
+        input.Press("VK_F");
+        Assert.Throws<InvalidOperationException>(input.VerifyDialogue);
+    }
+
+    [Fact]
+    public void ObservedDialogueMayReturnToWorldBeforeCompletion()
+    {
+        var inDialogue = false;
+        var input = new AgentScriptInput(_ => { }, _ => { }, _ => { },
+            ms => { if (ms == 400) inDialogue = true; }, () => inDialogue, true);
+        input.Press("F");
+        inDialogue = false;
+        input.VerifyDialogue();
+    }
