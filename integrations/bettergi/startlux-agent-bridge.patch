new file mode 100644
index 0000000..8d2f6ec
--- /dev/null
+++ b/BetterGenshinImpact/Service/Agent/AgentJournalRows.cs
@@ -0,0 +1,43 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using Newtonsoft.Json.Linq;
+
+namespace BetterGenshinImpact.Service.Agent;
+
+/// <summary>Bind changing handbook positions to stable commission identities.</summary>
+internal static class AgentJournalRows
+{
+    internal static (JArray Rows, Dictionary<int, JObject> Evidence) Bind(
+        JArray previous, JArray observed, IReadOnlyDictionary<int, JObject> observations)
+    {
+        if (observed.Count != 4
+            || !observed.Select(r => r.Value<int>("id")).Order().SequenceEqual(new[] { 1, 2, 3, 4 })
+            || observed.Any(r => string.IsNullOrWhiteSpace(r.Value<string>("name")))
+            || observed.Select(r => r.Value<string>("name")).Distinct(StringComparer.Ordinal).Count() != 4)
+            throw new InvalidDataException("All four unique journal identities must be recognized.");
+
+        var identities = (previous.Count == 0 ? observed : previous)
+            .ToDictionary(r => r.Value<string>("name")!, r => r.Value<int>("id"), StringComparer.Ordinal);
+        if (identities.Count != 4 || observed.Any(r => !identities.ContainsKey(r.Value<string>("name")!)))
+            throw new InvalidDataException("Journal identities changed; manual review is required.");
+
+        var rows = new List<JObject>();
+        var evidence = new Dictionary<int, JObject>();
+        foreach (var observedRow in observed)
+        {
+            var visibleSlot = observedRow.Value<int>("id");
+            if (!observations.TryGetValue(visibleSlot, out var observation))
+                throw new InvalidDataException("Each journal row requires an unambiguous visual status.");
+            var row = (JObject)observedRow.DeepClone();
+            var stableSlot = identities[row.Value<string>("name")!];
+            row["id"] = stableSlot;
+            var proof = (JObject)observation.DeepClone();
+            proof["quest_id"] = $"{stableSlot}:{row["name"]}";
+            rows.Add(row);
+            evidence.Add(stableSlot, proof);
+        }
+        return (new JArray(rows.OrderBy(r => r.Value<int>("id"))), evidence);
+    }
+}
diff --git a/BetterGenshinImpact/Service/Agent/AgentProgressSamples.cs b/BetterGenshinImpact/Service/Agent/AgentProgressSamples.cs
new file mode 100644
index 0000000..2f579cc
--- /dev/null
+++ b/BetterGenshinImpact/Service/Agent/AgentProgressSamples.cs
@@ -0,0 +1,39 @@
+using System;
+using System.Linq;
+using Newtonsoft.Json.Linq;
+
+namespace BetterGenshinImpact.Service.Agent;
+
+// Fixed-interval visual motion is a cue for Decision, never proof of kills or
+// completion. Enemy health and target distance remain unknown without detectors.
+public sealed class AgentProgressSamples
+{
+    private string? _phase;
+    private byte[]? _previous;
+    private long _at;
+    private int _samples;
+    private double _similarSeconds;
+    private double? _difference;
+    public JObject Observe(string phase, long milliseconds, byte[] grayscale)
+    {
+        if (grayscale.Length != 32 * 18) throw new ArgumentException("Expected a fixed-size world crop.");
+        if (_phase != phase)
+        { _phase = phase; _previous = null; _samples = 0; _similarSeconds = 0; _difference = null; }
+        if (_previous == null || milliseconds - _at >= 5000)
+        {
+            if (_previous != null)
+            {
+                _difference = grayscale.Zip(_previous, (a, b) => Math.Abs((int)a - b)).Average() / 255.0;
+                // A capture gap cannot be evidence of continuous inactivity.
+                _similarSeconds = milliseconds - _at <= 15000 && _difference < 0.02
+                    ? _similarSeconds + (milliseconds - _at) / 1000.0 : 0;
+            }
+            _previous = (byte[])grayscale.Clone(); _at = milliseconds; _samples++;
+        }
+        return new JObject { ["world_motion_difference"] = _difference,
+            ["similar_world_seconds"] = _similarSeconds, ["sample_count"] = _samples,
+            ["sample_age_seconds"] = Math.Max(0, milliseconds - _at) / 1000.0,
+            ["enemy_hp_fraction"] = null, ["target_distance"] = null,
+            ["interpretation"] = "visual_motion_cue_only_not_completion_or_damage" };
+    }
+}
