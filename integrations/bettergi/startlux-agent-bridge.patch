+using System;
+using System.Threading;
+using System.Threading.Tasks;
+using BetterGenshinImpact.AgentBridge;
+using Microsoft.Extensions.Hosting;
+using Microsoft.Extensions.Logging;
+
+namespace BetterGenshinImpact.Service.Agent;
+
+public sealed class StartLuxAgentBridgeService(ILogger<StartLuxAgentBridgeService> logger) : IHostedService
+{
+    private AgentCommandHost? _host;
+    private AgentPipeServer? _server;
+    private BetterGiAgentBackend? _backend;
+
+    public Task StartAsync(CancellationToken cancellationToken)
+    {
+        var configuration = Environment.GetEnvironmentVariable("STARTLUX_AGENT_CONFIG");
+        if (string.IsNullOrWhiteSpace(configuration)) return Task.CompletedTask;
+        var backend = new BetterGiAgentBackend(configuration);
+        _backend = backend;
+        _host = new AgentCommandHost(backend, backend.Options, metadata: backend.Metadata);
+        backend.ManualStop += _host.Stop;
+        var pipeName = Environment.GetEnvironmentVariable("STARTLUX_AGENT_PIPE") ?? "startlux-genshin";
+        _server = new AgentPipeServer(_host, pipeName);
+        _server.Start();
+        logger.LogInformation("StartLux development agent bridge started on local pipe {PipeName}", pipeName);
+        return Task.CompletedTask;
+    }
+
+    public async Task StopAsync(CancellationToken cancellationToken)
+    {
+        try
+        {
+            if (_server is not null) await _server.DisposeAsync();
+            if (_host is not null) await _host.DisposeAsync();
+        }
+        finally
+        {
+            if (_backend is not null) await _backend.StopRecordingAsync();
+        }
+    }
+}
