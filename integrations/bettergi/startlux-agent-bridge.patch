+using BetterGenshinImpact.Service.Agent;
+using Xunit;
+
+public sealed class AgentCommissionReceiptTests
+{
+    [Fact]
+    public void RealPaddleV6ToastWithoutMultiplicationGlyphIsRecognized()
+    {
+        var detector = new AgentCommissionReceipt();
+        detector.Observe(0, "", "");
+        detector.Observe(1000, "委托完成", "");
+        Assert.False(detector.Observe(4000, "", "委托奖励\n原石10\n冒险阅历250"));
+        Assert.True(detector.Observe(4250, "", "原石10\n冒险阅历250"));
+        Assert.Equal(10, detector.Amount);
+    }
+
+    [Fact]
+    public void PopupRequiresFreshCompletionAndDoesNotInventQuantity()
+    {
+        var detector = new AgentCommissionReceipt();
+        detector.Observe(0, "", "");
+        Assert.False(detector.Observe(1000, "", "", true));
+        Assert.False(detector.Observe(1250, "", "", true));
+        Assert.False(detector.Observe(2000, "委托完成", "", true));
+        Assert.True(detector.Observe(2250, "委托完成", "", true));
+        Assert.Null(detector.Amount);
+    }
+
+    [Fact]
+    public void ReceiptStopsAfterFreshBannerAndTwoFramesEvenWithNearbyEnemies()
+    {
+        var detector = new AgentCommissionReceipt();
+        Assert.False(detector.Observe(0, "攀高危险 1/2", ""));
+        Assert.False(detector.Observe(1000, "委托完成", ""));
+        Assert.False(detector.Observe(4000, "", "原石 × 10 冒险阅历 × 250"));
+        Assert.True(detector.Observe(4250, "敌人增援来袭", "原石 × 10 冒险阅历 × 250"));
+    }
+
+    [Theory]
+    [InlineData("", "原石 × 10")]
+    [InlineData("委托完成", "原石 × 100")]
+    [InlineData("委托完成", "原石 × 20")]
+    [InlineData("委托完成", "摩拉 × 10")]
+    [InlineData("", "战斗超时")]
+    public void UnrelatedRewardsMissingGemsAndTimeoutAreNeverSuccess(string banner, string loot)
+    {
+        var detector = new AgentCommissionReceipt();
+        detector.Observe(0, "", "");
+        Assert.False(detector.Observe(1000, banner, loot));
+        Assert.False(detector.Observe(1250, banner, loot));
+    }
+
+    [Fact]
+    public void PreviousQuestToastMustClearAndExpiredBannerCannotMatch()
+    {
+        var detector = new AgentCommissionReceipt();
+        Assert.False(detector.Observe(0, "委托完成", "委托奖励 原石×10"));
+        Assert.False(detector.Observe(500, "", "委托奖励 原石×10"));
+        detector.Observe(1000, "", "");
+        detector.Observe(2000, "委托完成", "");
+        Assert.False(detector.Observe(11000, "", "原石×10"));
+        Assert.False(detector.Observe(11250, "", "原石×10"));
+        Assert.False(detector.Observe(12000, "", "委托奖励 原石×10"));
+        Assert.True(detector.Observe(12250, "", "委托奖励 原石×10"));
+    }
+
+    [Fact]
+    public void SingleFrameAndLongGapsCannotTriggerReceipt()
+    {
+        var detector = new AgentCommissionReceipt();
+        detector.Observe(0, "", "");
+        Assert.False(detector.Observe(1000, "委托完成", "委托奖励 原石×10"));
+        Assert.False(detector.Observe(1000, "委托完成", "委托奖励 原石×10"));
+        Assert.False(detector.Observe(4000, "委托完成", "委托奖励 原石×10"));
+        Assert.True(detector.Observe(4250, "", "委托奖励 原石×10"));
+    }
+}
